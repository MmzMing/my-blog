---
import type { TagGraphData } from "@/utils/tag-graph-data";

interface Props {
	graph: TagGraphData;
}

const { graph } = Astro.props;
const accessibleLabel = `标签关系图谱，共 ${graph.nodes.length} 个标签、${graph.links.length} 条关联。使用方向键选择标签，回车打开。`;
const initialStatus =
	graph.nodes.length === 0 ? "暂无标签关系" : "正在准备图谱…";
---

<div
	id="tag-graph-container"
	class="tag-graph"
	data-graph={JSON.stringify(graph)}
>
  <div class="tag-graph__header">
    <p class="tag-graph__description">
      本关系图谱基于
      <a href="https://d3js.org/" target="_blank" rel="noopener noreferrer">D3.js</a>
      进行绘制。
    </p>
  </div>

  <div
    id="tag-graph-chart"
    class="tag-graph__chart"
    data-tag-graph-surface
    data-state={graph.nodes.length === 0 ? "empty" : "idle"}
  >
    <canvas
      class="tag-graph__canvas"
      data-tag-graph-canvas
      role="img"
      tabindex="0"
      aria-label={accessibleLabel}
    >
      {accessibleLabel}
    </canvas>
    <div
      class="tag-graph__status"
      data-tag-graph-status
      aria-live="polite"
    >
      {initialStatus}
    </div>
    <div
      class="tag-graph__tooltip"
      data-tag-graph-tooltip
      role="tooltip"
      aria-hidden="true"
      hidden
    >
      <strong data-tag-graph-tooltip-title></strong>
      <span data-tag-graph-tooltip-meta></span>
    </div>
  </div>
</div>

<script>
  import type { TagGraphController } from "@/utils/tag-graph-controller";

  let activeController: TagGraphController | null = null;
  let loadingObserver: IntersectionObserver | null = null;
  let loadVersion = 0;

  function cleanupTagGraphLoader() {
    loadVersion++;
    loadingObserver?.disconnect();
    loadingObserver = null;
    activeController?.destroy();
    activeController = null;
  }

  async function loadTagGraph(root: HTMLElement, version: number) {
    const surface = root.querySelector<HTMLElement>("[data-tag-graph-surface]");
    if (!surface || surface.dataset.state === "empty") return;

    surface.dataset.state = "loading";
    try {
      const { mountTagGraph } = await import("@/utils/tag-graph-controller");
      if (version !== loadVersion || !root.isConnected) return;
      activeController = mountTagGraph(root);
    } catch (error) {
      if (version !== loadVersion || !root.isConnected) return;
      surface.dataset.state = "error";
      const status = surface.querySelector<HTMLElement>("[data-tag-graph-status]");
      if (status) status.textContent = "关系图谱加载失败";
      console.error("Failed to load the tag graph", error);
    }
  }

  function initTagGraphLoader() {
    cleanupTagGraphLoader();

    const root = document.getElementById("tag-graph-container");
    if (!root) return;
    const surface = root.querySelector<HTMLElement>("[data-tag-graph-surface]");
    if (!surface || surface.dataset.state === "empty") return;

    const version = loadVersion;
    loadingObserver = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (!entry?.isIntersecting || surface.offsetWidth === 0 || surface.offsetHeight === 0) return;
      loadingObserver?.disconnect();
      loadingObserver = null;
      void loadTagGraph(root, version);
    }, { rootMargin: "120px 0px" });
    loadingObserver.observe(surface);
  }

  initTagGraphLoader();
  document.addEventListener("astro:page-load", initTagGraphLoader);
</script>
