---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { KGMeta } from "@/utils/knowledge-graph-data";

interface Props {
	meta: KGMeta;
}

const { meta } = Astro.props;

// 层级开关：标题层默认关 —— 179 个节点一上来就铺开会糊成一片
const tiers = [
	{
		key: "category",
		label: i18n(I18nKey.kgTierCategory),
		count: meta.counts.category,
		on: true,
	},
	{
		key: "tag",
		label: i18n(I18nKey.kgTierTag),
		count: meta.counts.tag,
		on: true,
	},
	{
		key: "post",
		label: i18n(I18nKey.kgTierPost),
		count: meta.counts.post,
		on: true,
	},
	{
		key: "heading",
		label: i18n(I18nKey.kgTierHeading),
		count: meta.counts.heading,
		on: false,
	},
];

const maxPosts = Math.max(1, ...meta.categories.map((c) => c.postCount));
const statsTemplate = i18n(I18nKey.kgStats);
---

{/* 右缘图标竖条 + 按需弹出的筛选面板，取代原先常驻右上角的整块控制面板。
    两者是兄弟而非嵌套：弹窗嵌进竖条会变成 flex item，还得跟 overflow 搏斗；
    仓库既有做法是独立定位元素 + JS 量测（见 navbar-dropdown-controller.ts:78）。

    高频动作（布局切换、共现连线、流动粒子、播放）直接摊成按钮，低频的
    搜索与勾选收进弹窗。aria-pressed 初值必须和 scene.ts 的 defaultFilters()
    对齐，否则按钮点亮态和画布实际状态会反着。

    弹窗几何（left/top 与箭头轴）由 src/utils/graph-dock-popover-controller.ts
    写内联样式，这里只给静态结构。控件全部构建期渲染，交互只切属性，
    零 DOM 创建 —— 与原面板一致 */}
<nav class="kg-dock" data-kg-dock aria-label={i18n(I18nKey.kgPanelTitle)}>
  <button
    type="button"
    class="kg-dock__btn"
    data-kg-action="toggle-popover"
    data-kg-popover-trigger
    aria-expanded="false"
    aria-controls="kg-filter-popover"
    data-tooltip={i18n(I18nKey.kgSectionFilters)}
    aria-label={i18n(I18nKey.kgSectionFilters)}
  >
    {/* 漏斗：原来那三条递减横线太容易被读成「列表」，筛选语义不直给 */}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 5.5h16l-6.2 7.3v5.4l-3.6 2.1v-7.5z" />
      </g>
    </svg>
  </button>
  <button
    type="button"
    class="kg-dock__btn"
    data-kg-action="toggle-layout"
    aria-pressed="false"
    data-tooltip={i18n(I18nKey.kgLayoutMindmap)}
    aria-label={i18n(I18nKey.kgLayoutMindmap)}
  >
    {/* 一颗按钮两态换图：力导向下显示脑图图标（切过去），脑图下反过来。
        切换由 graph-dock.css 的 [aria-pressed="true"] 规则负责，JS 只写状态 */}
    <svg class="kg-dock__icon kg-dock__icon--mindmap" viewBox="0 0 24 24" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path d="M7 12h3.2M10.2 12c2.7 0 2.5-7 6.1-7M10.2 12c2.7 0 2.5 7 6.1 7M10.2 12h6.1" />
        <circle cx="5" cy="12" r="1.9" />
        <circle cx="18.3" cy="5" r="1.9" />
        <circle cx="18.3" cy="12" r="1.9" />
        <circle cx="18.3" cy="19" r="1.9" />
      </g>
    </svg>
    <svg class="kg-dock__icon kg-dock__icon--force" viewBox="0 0 24 24" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path d="M12 12 6 6.8M12 12l7 2.6M12 12l-3 6.8" />
        <circle cx="12" cy="12" r="2.2" />
        <circle cx="6" cy="6.8" r="1.6" />
        <circle cx="19" cy="14.6" r="1.6" />
        <circle cx="9" cy="18.8" r="1.6" />
      </g>
    </svg>
  </button>
  <button
    type="button"
    class="kg-dock__btn"
    data-kg-action="reset-view"
    data-tooltip={i18n(I18nKey.kgResetView)}
    aria-label={i18n(I18nKey.kgResetView)}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V1L7 6l5 5V7a5 5 0 1 1-5 5H5a7 7 0 1 0 7-7z"/></svg>
  </button>
  <button
    type="button"
    class="kg-dock__btn"
    data-kg-action="toggle-cooccurrence"
    aria-pressed="false"
    data-tooltip={i18n(I18nKey.kgShowCooccurrence)}
    aria-label={i18n(I18nKey.kgShowCooccurrence)}
  >
    {/* 三个标签节点两两连成一个闭环 —— 这个开关加的就是 tag-tag 边，
        图标直接画它打开后画布上多出来的那种东西。线段端点按节点半径外扩留了
        间隙，不会戳进圆里 */}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path d="M8.5 7h7M7.02 9.58l3.46 5.84M16.98 9.58l-3.46 5.84" />
        <circle cx="5.5" cy="7" r="2.4" />
        <circle cx="18.5" cy="7" r="2.4" />
        <circle cx="12" cy="18" r="2.4" />
      </g>
    </svg>
  </button>
  <button
    type="button"
    class="kg-dock__btn"
    data-kg-action="toggle-particles"
    aria-pressed="true"
    data-tooltip={i18n(I18nKey.kgParticles)}
    aria-label={i18n(I18nKey.kgParticles)}
  >
    {/* 一条边线上三颗由小到大排开的实心粒子，就是画布里沿线跑的那种东西。
        线特意比别的图标细一档（1.4）、点放到 3.2–5.2 直径：点只比线宽一点点的话，
        缩到 22px 就糊成一条粗斜块，完全读不出是几颗。原来那道对称弧线则太容易
        被看成「微笑」或「桥」 */}
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <path d="M3 19 21 5" />
      </g>
      <g fill="currentColor">
        <circle cx="6.6" cy="16.2" r="1.6" />
        <circle cx="12" cy="12" r="2.1" />
        <circle cx="17.4" cy="7.8" r="2.6" />
      </g>
    </svg>
  </button>
  <button
    type="button"
    class="kg-dock__btn"
    data-kg-action="play"
    aria-pressed="false"
    data-tooltip={i18n(I18nKey.kgPlay)}
    aria-label={i18n(I18nKey.kgPlay)}
  >
    {/* 这两个图标由 onPlayback 直接写 style.display（svg 上放不了 hidden 属性，
        Astro 类型不收），所以初值写在 style 上 */}
    <svg class="kg-dock__icon" data-kg-icon="play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
    <svg class="kg-dock__icon" data-kg-icon="pause" viewBox="0 0 24 24" aria-hidden="true" style="display: none;"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
  </button>
</nav>

<div
  class="kg-dock__popover"
  id="kg-filter-popover"
  data-kg-popover
  role="dialog"
  aria-label={i18n(I18nKey.kgPanelTitle)}
  inert
>
  <p class="graph-panel__stats" data-kg-stats data-template={statsTemplate}></p>
  <span class="kg-dock__arrow" aria-hidden="true"></span>
  <div class="kg-dock__popover-body">
    <section class="kg-dock__section">
      <h2 class="kg-dock__section-title">{i18n(I18nKey.kgSectionFilters)}</h2>
      <div class="graph-panel__fields">
        <label class="graph-panel__search">
          <input type="search" data-kg-filter="query" placeholder={i18n(I18nKey.kgSearch)} />
        </label>
        {/* 最少文章数紧跟搜索：两者都是「缩小范围」，层级勾选是「选哪些层」 */}
        <label class="graph-panel__range">
          <span>{i18n(I18nKey.kgMinPosts)}</span>
          <input type="range" data-kg-filter="minPosts" min="1" max={maxPosts} value="1" step="1" />
          <output data-kg-out="minPosts">1</output>
        </label>
        <div class="graph-panel__grid">
          {tiers.map((tier) => (
            <label class="graph-panel__check">
              <input type="checkbox" data-kg-tier={tier.key} checked={tier.on} />
              <span class="graph-panel__box" aria-hidden="true"></span>
              <span class="graph-panel__check-label">{tier.label}</span>
              <span class="graph-panel__count">{tier.count}</span>
            </label>
          ))}
        </div>
      </div>
    </section>

    {/* 分类选择：带色点的分类勾选，图例与画布节点同色 */}
    <section class="kg-dock__section">
      <h2 class="kg-dock__section-title">{i18n(I18nKey.kgSectionGroups)}</h2>
      <div class="graph-panel__fields">
        <div class="graph-panel__grid">
          {meta.categories.map((category) => (
            <label class="graph-panel__check" data-color-index={category.colorIndex}>
              <input type="checkbox" data-kg-category={category.id} checked />
              <span class="graph-panel__box" aria-hidden="true"></span>
              <span class="graph-panel__dot" aria-hidden="true"></span>
              <span class="graph-panel__check-label">{category.name}</span>
              <span class="graph-panel__count">{category.postCount}</span>
            </label>
          ))}
        </div>
      </div>
    </section>
  </div>
</div>
