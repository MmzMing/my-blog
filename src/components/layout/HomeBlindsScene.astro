---
import type { HomeBlindsSceneItem } from "@/types/config";

interface Props {
	index: number;
	item: HomeBlindsSceneItem;
	/** 首幕由上一层背景合成，图片与固定舞台共用同一张 */
	composite?: boolean;
}

const { index, item, composite = false } = Astro.props;

// 五幕统一为明信片版式：双数幕挂高（垂直中心落在视口 42% 处），
// 单数幕垂直居中，左右两张错落排布
const isRaised = index % 2 === 1;

const CN_DIGITS = ["零", "一", "二", "三", "四", "五", "六", "七", "八", "九"];

/**
 * 配置里的落款是 "2026 / 06 / 10"，底栏要拆成两行：
 * 上行中文年（二零二六年），下行月日数字（06 / 10）。
 * 年份不是纯数字时原样保留，不猜写法。
 */
function splitSceneDate(date: string | undefined) {
	if (!date) return null;
	const [year, ...rest] = date.split("/");
	const monthDay = rest.map((part) => part.trim()).join(" / ");
	if (!year || !monthDay) return null;
	const digits = year.trim().split("");
	const isAllDigits = digits.every((d) => d >= "0" && d <= "9");
	return {
		yearText: isAllDigits
			? `${digits.map((d) => CN_DIGITS[Number(d)]).join("")}年`
			: year.trim(),
		monthDay,
	};
}

const sceneDate = splitSceneDate(item.date);
---

<article
	class:list={[
		"home-blinds-scene",
		{ "home-blinds-scene--raised": isRaised },
		{ "home-blinds-scene--composite": composite },
	]}
	data-home-blinds-scene
	data-scene-index={index}
	aria-label={item.title}
>
	<div class="home-blinds-scene__swing" data-scene-swing>
		<!-- 吊线：自视窗顶部垂到卡顶正中，放在 swing 内与卡身一起绕挂点倾斜 -->
		<span class="home-blinds-scene__string" aria-hidden="true"></span>

		<div class="home-blinds-scene__rail" data-scene-rail>
			<span class="home-blinds-scene__rail-dot" aria-hidden="true" data-scene-rail-dot
			></span>
			<span class="home-blinds-scene__rail-eyebrow" data-scene-rail-eyebrow
				>{item.eyebrow}</span
			>
			<span class="home-blinds-scene__rail-line" aria-hidden="true" data-scene-rail-line
			></span>
			<span class="home-blinds-scene__rail-title" data-scene-rail-title
				>{item.title}</span
			>
		</div>

		<div class="home-blinds-scene__card">
			<span class="home-blinds-scene__tape" aria-hidden="true"></span>
			<span class="home-blinds-scene__sticker" aria-hidden="true" data-scene-sticker>
				{index + 1}
			</span>

			<div class="home-blinds-scene__frame" data-scene-frame>
				<img
					class="home-blinds-scene__image"
					src={index === 0 ? undefined : item.image}
					data-home-blinds-src={index === 0 ? item.image : undefined}
					alt={item.alt}
					loading={index === 0 ? undefined : "lazy"}
					decoding="async"
				/>
			</div>

			<!-- 底部介绍区：左列中文年 + 月日数字，竖杠分隔，右栏说明最多两行 -->
			<div class="home-blinds-scene__band">
				{
					sceneDate && (
						<>
							<div class="home-blinds-scene__band-id" data-scene-band>
								<p class="home-blinds-scene__band-year">
									{sceneDate.yearText}
								</p>
								<p class="home-blinds-scene__band-date">
									{sceneDate.monthDay}
								</p>
							</div>
							<span
								class="home-blinds-scene__band-divider"
								data-scene-band-divider
								aria-hidden="true"
							></span>
						</>
					)
				}
				<p class="home-blinds-scene__band-note" data-scene-note>
					{item.description}
				</p>
			</div>
		</div>
	</div>
</article>
