---
import dayjs from "dayjs";
import type { HomeBlindsSceneItem } from "@/types/config";

interface Props {
	index: number;
	item: HomeBlindsSceneItem;
	/** 首幕由上一层背景合成，图片与固定舞台共用同一张 */
	composite?: boolean;
}

const { index, item, composite = false } = Astro.props;

// 五幕统一为明信片版式：双数幕挂高（垂直中心落在视口 42% 处），
// 单数幕垂直居中，左右两张错落排布
const isRaised = index % 2 === 1;

const sceneDate = item.date
	? dayjs(item.date.replace(/\s+/gu, "")).format("YYYY/MM/DD")
	: null;

// 数字保留真实笔顺，描线时不用测字形轮廓，也不依赖客户端字体。
const numberStrokes = [
	["M42 38L55 28L55 68", "M42 70H68"],
	["M36 38C38 23 66 24 68 38C70 49 47 57 36 70H70"],
	[
		"M37 31C49 25 68 28 67 39C67 46 59 49 49 49C63 48 72 54 68 63C64 74 44 74 35 66",
	],
	["M56 29L35 55H70", "M61 29V71"],
	["M69 29H40L37 49C49 42 69 46 69 59C69 74 45 76 35 66"],
][index];
const stickerEdge =
	"M18 9L85 6Q93 5 97 15L100 37L97 43L102 49V64L82 88L21 92Q11 93 10 83L5 24Q4 13 18 9Z";
---

<article
	class:list={[
		"home-blinds-scene",
		{ "home-blinds-scene--raised": isRaised },
		{ "home-blinds-scene--composite": composite },
	]}
	data-home-blinds-scene
	data-scene-index={index}
	aria-label={item.title}
>
	<div class="home-blinds-scene__swing" data-scene-swing>
		<!-- 木夹分前后两层：后木臂被纸面遮住，前夹口压在照片上，双线随卡身一起摆动 -->
		{
			["left", "right"].map((side) => (
				<div
					class={`home-blinds-scene__hanger home-blinds-scene__hanger--${side}`}
					aria-hidden="true"
				>
					<span class="home-blinds-scene__string" />
					<svg
						class="home-blinds-scene__clip home-blinds-scene__clip--back"
						viewBox="0 0 84 182"
						fill="none"
					>
						<g transform="translate(0 182) rotate(-90)">
							<path
								class="home-blinds-scene__clip-back"
								d="M21 69L173 30Q179 28 177 34L75 70L25 78Q19 79 21 69Z"
							/>
							<path
								class="home-blinds-scene__clip-bevel"
								d="M25 74L75 66L175 31L177 34L75 70L25 78Z"
							/>
							<path
								class="home-blinds-scene__clip-grain"
								d="M84 62L158 36M42 70L68 66"
							/>
						</g>
					</svg>
					<svg
						class="home-blinds-scene__clip home-blinds-scene__clip--front"
						viewBox="0 0 84 182"
						fill="none"
					>
						<g transform="translate(0 182) rotate(-90)">
							<!-- 与木臂同形的短偏移阴影贴住纸面，夹口留出真实凹槽 -->
							<path
								class="home-blinds-scene__clip-shadow"
								d="M10 43L163 7Q168 6 166 11L120 40L111 39Q105 38 105 43L59 58C62 51 60 43 53 41C45 39 39 45 40 53C41 61 47 63 53 61L23 72L7 50Q4 46 10 43Z"
								transform="translate(-2 3)"
							/>
							<path
								class="home-blinds-scene__clip-wood"
								d="M10 43L163 7Q168 6 166 11L120 40L111 39Q105 38 105 43L59 58C62 51 60 43 53 41C45 39 39 45 40 53C41 61 47 63 53 61L23 72L7 50Q4 46 10 43Z"
							/>
							<path
								class="home-blinds-scene__clip-bevel"
								d="M7 50L23 72L53 61L48 61L24 67L9 47ZM60 54L105 40V43L59 58Z"
							/>
							<path
								class="home-blinds-scene__clip-highlight"
								d="M13 45L157 11M25 65L35 61"
							/>
							<path
								class="home-blinds-scene__clip-grain"
								d="M68 36L141 16M83 39L128 24M18 49L34 45M24 55L34 52M64 45L88 38"
							/>
							<path
								class="home-blinds-scene__clip-wire-shadow"
								d="M115 43L80 63L57 61M113 31L102 26"
							/>
							<path
								class="home-blinds-scene__clip-wire"
								d="M115 43L80 63L57 61M113 31L102 26"
							/>
							<circle class="home-blinds-scene__clip-coil-base" cx="119" cy="36" r="8" />
							<circle class="home-blinds-scene__clip-coil" cx="119" cy="36" r="6" />
						</g>
					</svg>
				</div>
			))
		}

		<div class="home-blinds-scene__card">
			<svg
				class="home-blinds-scene__sticker"
				viewBox="0 0 112 100"
				fill="none"
				aria-hidden="true"
				data-scene-sticker
			>
				<g data-scene-sticker-fill>
					<path
						class="home-blinds-scene__sticker-shadow"
						d={stickerEdge}
						transform="translate(1 4)"
					/>
					<path class="home-blinds-scene__sticker-paper" d={stickerEdge} />
					<path
						class="home-blinds-scene__sticker-face"
						d="M21 17L84 13Q88 12 90 20L93 37L90 43L95 50V62L77 81L23 85Q18 86 18 80L12 25Q11 19 21 17Z"
					/>
					<path
						class="home-blinds-scene__sticker-fold"
						d="M82 88L79 72Q78 66 85 65L102 64Z"
					/>
				</g>
				<path
					class="home-blinds-scene__sticker-outline"
					d={stickerEdge}
					pathLength="1"
					data-scene-sticker-outline
				/>
				{
					numberStrokes.map((d) => (
						<path
							class="home-blinds-scene__sticker-number"
							d={d}
							pathLength="1"
							data-scene-sticker-ink
						/>
					))
				}
				<path
					class="home-blinds-scene__sticker-crease"
					d="M82 88L79 72Q78 66 85 65L102 64"
					pathLength="1"
					data-scene-sticker-ink
				/>
				<path
					class="home-blinds-scene__sticker-glint"
					d="M81 24L80 33M76 29L85 28"
					pathLength="1"
					data-scene-sticker-ink
				/>
			</svg>

			<div class="home-blinds-scene__frame" data-scene-frame>
				<img
					class="home-blinds-scene__image"
					src={index === 0 ? undefined : item.image}
					data-home-blinds-src={index === 0 ? item.image : undefined}
					alt={item.alt}
					loading={index === 0 ? undefined : "lazy"}
					decoding="async"
				/>
			</div>

			<!-- 标题与完整日期各占一层，保留独立节点供入场动效错峰显示 -->
			<div class="home-blinds-scene__band">
				<div class="home-blinds-scene__band-id">
					<p class="home-blinds-scene__band-title" data-scene-title>
						{item.title}
					</p>
					{
						sceneDate && (
							<p class="home-blinds-scene__band-date" data-scene-date>
								{sceneDate}
							</p>
						)
					}
				</div>
				<span
					class="home-blinds-scene__band-divider"
					data-scene-band-divider
					aria-hidden="true"
				></span>
				<p class="home-blinds-scene__band-note" data-scene-note>
					{item.description}
				</p>
			</div>
		</div>
	</div>
</article>
