---
import type { HomeBlindsSceneItem } from "@/types/config";

interface Props {
	index: number;
	item: HomeBlindsSceneItem;
	/** 首幕由上一层背景合成，图片与固定舞台共用同一张 */
	composite?: boolean;
}

const { index, item, composite = false } = Astro.props;

// 五幕统一为明信片版式：双数幕挂高（垂直中心落在视口上 1/3 处），
// 单数幕垂直居中，左右两张错落排布
const isRaised = index % 2 === 1;
const captionChars = Array.from(item.description);
---

<article
	class:list={[
		"home-blinds-scene",
		{ "home-blinds-scene--raised": isRaised },
		{ "home-blinds-scene--composite": composite },
	]}
	data-home-blinds-scene
	data-scene-index={index}
	aria-label={item.title}
>
	<div class="home-blinds-scene__swing" data-scene-swing>
		<!-- 吊线：自视窗顶部垂到卡顶正中，放在 swing 内与卡身一起绕挂点倾斜 -->
		<span class="home-blinds-scene__string" aria-hidden="true"></span>

		<div class="home-blinds-scene__rail" data-scene-rail>
			<span class="home-blinds-scene__rail-dot" aria-hidden="true" data-scene-rail-dot
			></span>
			<span class="home-blinds-scene__rail-eyebrow" data-scene-rail-eyebrow
				>{item.eyebrow}</span
			>
			<span class="home-blinds-scene__rail-line" aria-hidden="true" data-scene-rail-line
			></span>
			<span class="home-blinds-scene__rail-title" data-scene-rail-title
				>{item.title}</span
			>
		</div>

		<div class="home-blinds-scene__card">
			<span class="home-blinds-scene__tape" aria-hidden="true"></span>
			<span class="home-blinds-scene__sticker" aria-hidden="true" data-scene-sticker>
				{index + 1}
			</span>

			<div class="home-blinds-scene__frame" data-scene-frame>
				<img
					class="home-blinds-scene__image"
					src={item.image}
					alt={item.alt}
					loading={index === 0 ? "eager" : "lazy"}
					decoding="async"
				/>
			</div>

			<div class="home-blinds-scene__band">
				<svg
					class="home-blinds-scene__doodles"
					viewBox="0 0 720 96"
					fill="none"
					preserveAspectRatio="none"
					aria-hidden="true"
				>
					<path class="home-blinds-scene__doodle-pencil" d="M42 74q12-9 24 0t24 0t24 0" />
					<circle class="home-blinds-scene__doodle-pencil" cx="196" cy="30" r="8" />
					<path class="home-blinds-scene__doodle-pencil" d="M560 78l26-6m8-4 18-4" />
					<path
						class="home-blinds-scene__doodle-accent"
						d="M664 20l4.5 11 11 4.5-11 4.5-4.5 11-4.5-11-11-4.5 11-4.5z"
					/>
				</svg>
				<p class="home-blinds-scene__caption" data-scene-caption>
					{
						captionChars.map((char) => (
							<span class="home-blinds-scene__caption-char" data-scene-caption-char>
								{char}
							</span>
						))
					}
				</p>
				{
					item.date && (
						<span
							class="home-blinds-scene__date"
							aria-hidden="true"
							data-scene-date
						>
							<span class="home-blinds-scene__date-text">
								{
									Array.from(item.date).map((char) => (
										<span
											class="home-blinds-scene__date-char"
											data-scene-date-char
										>
											{char}
										</span>
									))
								}
							</span>
							<svg
								class="home-blinds-scene__date-art"
								viewBox="0 0 272 24"
								fill="none"
							>
								<path
									class="home-blinds-scene__date-flourish"
									data-scene-date-flourish
									d="M4 12C44 22 100 2 152 10S234 20 268 4"
									pathLength="1"
									stroke="currentColor"
									stroke-width="3.2"
									stroke-linecap="round"
								/>
							</svg>
						</span>
					)
				}
			</div>
		</div>
	</div>
</article>
