---
import Icon from "@components/common/Icon.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
---

<nav class="home-hero__quick-panel" aria-label={i18n(I18nKey.quickActions)} data-hero-quick-panel>
	<div class="home-hero__quick-actions">
		<button
			class="home-hero__quick-action home-hero__dialogue-restore"
			type="button"
			data-hero-dialogue-restore
			aria-label={i18n(I18nKey.reopenDialogue)}
			aria-hidden="true"
			tabindex="-1"
		>
			<Icon name="material-symbols:chat-bubble-outline-rounded" is:inline aria-hidden="true" />
					<span>{i18n(I18nKey.dialogueRestoreHint)}</span>
		</button>
	</div>
</nav>
