---
interface Props {
	title: string;
	note?: string;
	puzzleViewBox: string;
}

const { title, note, puzzleViewBox } = Astro.props;
const COVER_COLUMNS = 6;
const COVER_ROWS = 6;

const tiles = Array.from(
	{ length: COVER_COLUMNS * COVER_ROWS },
	(_, index) => ({
		column: index % COVER_COLUMNS,
		row: Math.floor(index / COVER_COLUMNS),
	}),
);

const coverStyle = [
	`--cover-columns: ${COVER_COLUMNS}`,
	`--cover-rows: ${COVER_ROWS}`,
	// 两面以整组卡片为画布，卡缝收拢时印花位置也随轨道尺寸更新。
	`--cover-print-width: calc(${COVER_COLUMNS} * 100% + ${COVER_COLUMNS - 1} * var(--cover-gap))`,
	`--cover-print-height: calc(${COVER_ROWS} * 100% + ${COVER_ROWS - 1} * var(--cover-gap))`,
].join(";");
---

<div
	class="home-hero__cover"
	data-hero-cover
	aria-hidden="true"
	style={coverStyle}
>
	<div class="home-hero__cover-grid">
		{
			tiles.map((tile) => (
				<div
					class="home-hero__cover-tile"
					style={[
						`--cover-offset-x: calc(-${tile.column} * 100% - ${tile.column} * var(--cover-gap));`,
						`--cover-offset-y: calc(-${tile.row} * 100% - ${tile.row} * var(--cover-gap));`,
					].join(" ")}
				>
					<div class="home-hero__cover-card" data-hero-cover-card>
						<div class="home-hero__cover-face home-hero__cover-front">
							<span class="home-hero__cover-print">
								<span class="home-hero__cover-title">{title}</span>
								{note && <span class="home-hero__cover-note">{note}</span>}
							</span>
						</div>
						<div class="home-hero__cover-face home-hero__cover-back">
							<svg
								class="home-hero__cover-seams"
								viewBox={puzzleViewBox}
								preserveAspectRatio="xMidYMid slice"
								aria-hidden="true"
								focusable="false"
							>
								<use href="#home-hero-puzzle-seams" />
							</svg>
						</div>
					</div>
				</div>
			))
		}
	</div>
</div>
