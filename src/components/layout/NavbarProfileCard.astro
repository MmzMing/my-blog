---
import { Picture } from "astro:assets";
import * as path from "node:path";
import Icon from "@components/common/Icon.astro";
import type { ImageMetadata } from "astro";
import {
	calendarConfig,
	footerConfig,
	homeConfig,
	navBarConfig,
	siteConfig,
} from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { LinkPreset } from "@/types/config";
import { getFallbackFormat, getImageFormats } from "@/utils/image-utils";
import { resolveYearlyDate } from "@/utils/lunar-utils";
import { url } from "@/utils/url-utils";

const aboutLink = LinkPresets[LinkPreset.About];
const displayName = homeConfig.displayName || homeConfig.name;
const locale = siteConfig.lang.replace("_", "-");

// 卡片图片解析：src 目录（构建期优化）/ public（"/" 开头）/ 远程 URL，
// 三种约定与 Navbar logo 一致；头像与横幅共用这一份实现
const cardImageFiles = import.meta.glob<ImageMetadata>(
	"../../**/*.{png,jpg,jpeg,webp,avif,gif,svg}",
	{ import: "default" },
);

type ResolvedCardImage =
	| { kind: "optimized"; meta: ImageMetadata }
	| { kind: "direct"; src: string }
	| { kind: "none" };

async function resolveCardImage(value: string): Promise<ResolvedCardImage> {
	if (!value) return { kind: "none" };
	if (value.startsWith("/")) return { kind: "direct", src: url(value) };
	if (value.startsWith("http")) return { kind: "direct", src: value };
	const normalizedPath = path
		.normalize(path.join("../../", value))
		.replace(/\\/g, "/");
	const file = cardImageFiles[normalizedPath];
	if (!file) return { kind: "none" };
	return { kind: "optimized", meta: await file() };
}

const avatarImage = await resolveCardImage(homeConfig.avatar || "");
const bannerImage = await resolveCardImage(homeConfig.avatarBanner || "");

// 横幅两层同时渲染：糊化头像垫底，真横幅压在上层，
// 横幅缺位或加载失败时（控制器写 data-profile-banner-state）自然露出垫底
interface BannerLayerDef {
	slotClass: string;
	/** 控制器据此定位内层 img 接 error 事件，只挂在横幅上层 */
	isBannerImg: boolean;
	meta: ImageMetadata | null;
	directSrc: string;
	widths: number[];
}

function toBannerLayer(
	image: ResolvedCardImage,
	slotClass: string,
	isBannerImg: boolean,
	widths: number[],
): BannerLayerDef | null {
	if (image.kind === "none") return null;
	return image.kind === "optimized"
		? { slotClass, isBannerImg, meta: image.meta, directSrc: "", widths }
		: { slotClass, isBannerImg, meta: null, directSrc: image.src, widths };
}

const bannerLayers: BannerLayerDef[] = [
	toBannerLayer(avatarImage, "profile-card__banner-slot--blur", false, [64]),
	toBannerLayer(
		bannerImage,
		"profile-card__banner-slot--main",
		true,
		[336, 672],
	),
].filter((layer): layer is BannerLayerDef => layer !== null);

// 标签页定义：顺序即滑动方向序（索引增大 = 内容从右侧滑入）。
// 站点页沿用既有 otherSites 文案，不新增重复 key
type ProfileTabId = "heatmap" | "dates" | "sites";
interface ProfileTabDef {
	id: ProfileTabId;
	label: string;
}

const tabs: ProfileTabDef[] = [
	{ id: "heatmap", label: i18n(I18nKey.profileTabHeatmap) },
	{ id: "dates", label: i18n(I18nKey.profileTabDates) },
];
if (navBarConfig.personalSites.length > 0) {
	tabs.push({ id: "sites", label: i18n(I18nKey.otherSites) });
}
const initialTab = tabs[0].id;

// 建站日事件序列：构建期展开前后三年内联进面板，客户端据此算周期进度，无运行时请求
const currentYear = new Date().getFullYear();
const anniversaryOccurrences = [currentYear - 1, currentYear, currentYear + 1]
	.map((year) => resolveYearlyDate(calendarConfig.siteAnniversary.date, year))
	.filter((date): date is string => date !== null)
	.sort((a, b) => a.localeCompare(b));

// 热力图构建期静态渲染：48 个方块 + 月份表头，
// 数据到达后控制器只补计数色阶与提示文案，不再重建 DOM
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
const formatWeekLabel = (month: number, week: number): string =>
	i18n(I18nKey.profileMonthWeek)
		.replace("{month}", monthFormatter.format(new Date(2000, month, 1)))
		.replace("{week}", String(week + 1));

const profileConfig = JSON.stringify({
	api: {
		holidays: url("/api/holidays.json"),
		posts: url("/api/allPostMeta.json"),
	},
	postBaseUrl: url("/posts/"),
	locale,
	anniversary: {
		name: calendarConfig.siteAnniversary.name,
		occurrences: anniversaryOccurrences,
	},
	labels: {
		weekFormat: i18n(I18nKey.profileMonthWeek),
		postCount: i18n(I18nKey.profilePostCount),
		days: i18n(I18nKey.dayShort),
		unavailable: i18n(I18nKey.calendarDataUnavailable),
		noHoliday: i18n(I18nKey.calendarNoHoliday),
	},
});
---

<div class="navbar-profile-dropdown" data-navbar-profile-panel>
	<div class="navbar-profile-mask" data-profile-mask aria-hidden="true"></div>
	<div
		class="profile-card"
		data-profile-card
		data-profile-config={profileConfig}
		aria-busy="true"
	>
		<!-- 第一层：横幅 + 头像堆叠 -->
		<div class="profile-card__header">
			<div class="profile-card__banner">
				{bannerLayers.map((layer) => (
					<div
						class={`profile-card__banner-slot ${layer.slotClass}`}
						{...(layer.isBannerImg ? { "data-profile-banner-img": "" } : {})}
					>
						{layer.meta ? (
							layer.meta.format === "svg" ? (
								<img src={layer.meta.src} alt="" loading="lazy" decoding="async" />
							) : (
								<Picture
									src={layer.meta}
									alt=""
									formats={getImageFormats()}
									fallbackFormat={getFallbackFormat()}
									widths={layer.widths}
									loading="lazy"
								/>
							)
						) : (
							<img src={layer.directSrc} alt="" loading="lazy" decoding="async" />
						)}
					</div>
				))}
			</div>
			<a
				class="profile-card__avatar"
				href={url(aboutLink.url)}
				aria-label={aboutLink.name}
			>
				{avatarImage.kind === "optimized" ? (
					avatarImage.meta.format === "svg" ? (
						<img src={avatarImage.meta.src} alt="" class="profile-card__avatar-img" loading="lazy" decoding="async" />
					) : (
						<Picture
							src={avatarImage.meta}
							alt=""
							class="profile-card__avatar-img"
							formats={getImageFormats()}
							fallbackFormat={getFallbackFormat()}
							widths={[96, 192]}
							loading="lazy"
						/>
					)
				) : avatarImage.kind === "direct" ? (
					<img
						src={avatarImage.src}
						alt=""
						class="profile-card__avatar-img"
						loading="lazy"
						decoding="async"
					/>
				) : (
					<span class="profile-card__avatar-fallback">{displayName.slice(0, 1)}</span>
				)}
				<!-- 悬停遮罩：头像本身也是关于页入口 -->
				<span class="profile-card__avatar-mask">
					<span class="profile-card__avatar-mask-text">{aboutLink.name}</span>
				</span>
			</a>
		</div>

		<!-- 第二层：名字 / 职业（整块跳关于页）+ 社交入口 -->
		<a
			class="profile-card__identity"
			href={url(aboutLink.url)}
			aria-label={aboutLink.name}
		>
			<span class="profile-card__identity-text">
				<strong class="profile-card__name">{displayName}</strong>
				{homeConfig.occupation && <span class="profile-card__occupation">{homeConfig.occupation}</span>}
			</span>
		</a>

		<div class="profile-card__socials">
			{footerConfig.socialLinks.map((social) => {
				const isDirect = social.href.startsWith("mailto:") || social.href.startsWith("tel:");
				return (
					<a
						class="profile-card__social-btn"
						href={social.href}
						target={isDirect ? undefined : "_blank"}
						rel={isDirect ? undefined : "noopener noreferrer"}
						aria-label={social.label}
						data-tooltip-label={social.label}
					>
						<Icon name={social.icon} is:inline />
					</a>
				);
			})}
		</div>

		<!-- 第三层：内容区，三页互斥、高度跟随当前页、超出上限时页内滚动 -->
		<div class="profile-card__content" data-profile-content>
			<section
				class="profile-card__pane"
				data-profile-pane="heatmap"
				id="profile-pane-heatmap"
				role="tabpanel"
				aria-labelledby="profile-tab-heatmap"
				hidden={initialTab !== "heatmap"}
			>
				<div class="profile-card__heatmap" data-profile-heatmap role="group" aria-label={i18n(I18nKey.profileHeatmap)}>
					{Array.from({ length: 12 }, (_, month) => (
						<div class="profile-card__heat-col">
							<span class="profile-card__heat-month" aria-hidden="true">{month + 1}</span>
							{Array.from({ length: 4 }, (_, week) => {
								const label = formatWeekLabel(month, week);
								return (
									<button
										type="button"
										class="profile-card__heat-cell"
										data-profile-cell={`${month}-${week}`}
										data-tooltip-label={label}
										aria-label={label}
										aria-pressed="false"
									/>
								);
							})}
						</div>
					))}
				</div>

				<!-- 点格内联展开该周文章，不再是独立面板 -->
				<div class="profile-card__week-posts" data-profile-week hidden>
					<p class="profile-card__posts-title" data-profile-posts-title></p>
					<div class="profile-card__post-list" data-profile-post-list></div>
				</div>
			</section>

			<section
				class="profile-card__pane"
				data-profile-pane="dates"
				id="profile-pane-dates"
				role="tabpanel"
				aria-labelledby="profile-tab-dates"
				hidden={initialTab !== "dates"}
			>
				<div class="profile-card__countdowns">
					<div class="profile-card__countdown">
						<span>{i18n(I18nKey.calendarWeekRemaining)}</span>
						<strong data-profile-days="week">--</strong>
					</div>
					<div class="profile-card__countdown">
						<span>{i18n(I18nKey.calendarMonthRemaining)}</span>
						<strong data-profile-days="month">--</strong>
					</div>
					<div class="profile-card__countdown">
						<span>{i18n(I18nKey.calendarYearRemaining)}</span>
						<strong data-profile-days="year">--</strong>
					</div>
				</div>

				<article class="profile-card__event" data-profile-event="holiday">
					<div class="profile-card__event-main">
						<strong class="profile-card__event-title" data-profile-event-title>--</strong>
						<span class="profile-card__event-date" data-profile-event-date></span>
					</div>
					<div class="profile-card__progress-row">
						<span
							class="profile-card__progress"
							role="progressbar"
							aria-valuemin="0"
							aria-valuemax="100"
							aria-valuenow="0"
							data-profile-event-progress
						>
							<span data-profile-event-progress-fill></span>
						</span>
						<span class="profile-card__remaining" data-profile-event-remaining>--</span>
					</div>
				</article>

				<article class="profile-card__event" data-profile-event="anniversary">
					<div class="profile-card__event-main">
						<strong class="profile-card__event-title" data-profile-event-title>--</strong>
						<span class="profile-card__event-date" data-profile-event-date></span>
					</div>
					<div class="profile-card__progress-row">
						<span
							class="profile-card__progress"
							role="progressbar"
							aria-valuemin="0"
							aria-valuemax="100"
							aria-valuenow="0"
							data-profile-event-progress
						>
							<span data-profile-event-progress-fill></span>
						</span>
						<span class="profile-card__remaining" data-profile-event-remaining>--</span>
					</div>
				</article>
			</section>

			{navBarConfig.personalSites.length > 0 && (
				<section
					class="profile-card__pane"
					data-profile-pane="sites"
					id="profile-pane-sites"
					role="tabpanel"
					aria-labelledby="profile-tab-sites"
					hidden={initialTab !== "sites"}
				>
					{navBarConfig.personalSites.map((site) => (
						<a
							class="profile-card__site-cta"
							href={site.url}
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="profile-card__site-cta-name">{site.name}</span>
							<Icon name="fa7-solid:arrow-up-right-from-square" is:inline class="profile-card__site-cta-arrow" />
						</a>
					))}
				</section>
			)}
		</div>

		<!-- 热力图提示浮层：与内容区同级，不受页内 overflow 裁剪，由控制器定位 -->
		<div class="profile-card__tooltip" data-profile-tooltip aria-hidden="true"></div>

		<!-- 第四层：分段控件式标签 dock。外层是移动端 sticky 条，内层才是胶囊轨道 -->
		<div class="profile-card__tabbar">
			<div class="profile-card__tabs" data-profile-tabs role="tablist" aria-label={i18n(I18nKey.profileTabsLabel)}>
				{tabs.map((tab) => (
					<button
						type="button"
						class="profile-card__tab"
						id={`profile-tab-${tab.id}`}
						data-profile-tab={tab.id}
						role="tab"
						aria-controls={`profile-pane-${tab.id}`}
						aria-selected={tab.id === initialTab}
						tabindex={tab.id === initialTab ? 0 : -1}
					>
						{tab.label}
					</button>
				))}
			</div>
		</div>
	</div>
</div>

<!-- 样式见 src/styles/layout/navbar-profile-card.css -->

<script>
	import { initNavbarProfileCard } from "@/utils/navbar-profile-controller";
	import { definePersistentIsland } from "@/utils/swup-lifecycle";

	// 面板在 Swup 容器之外，常驻只需初始化一次
	definePersistentIsland("navbar-profile-card", initNavbarProfileCard);
</script>
