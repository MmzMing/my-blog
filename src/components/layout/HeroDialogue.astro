---
import Icon from "@components/common/Icon.astro";
import HeroSticker from "@components/layout/HeroSticker.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { HeroDialogueConfig, HeroStickerConfig } from "@/types/config";

interface Props {
	config: HeroDialogueConfig;
	sticker: HeroStickerConfig;
	fallbackHostName: string;
}

const { config, sticker, fallbackHostName } = Astro.props;
const dialogueConfig = {
	speakers: {
		host: config.speakers?.host || fallbackHostName,
		visitor: config.speakers?.visitor || i18n(I18nKey.visitor),
	},
	menuTitle: config.menuTitle || i18n(I18nKey.dialogueMenuTitle),
	typingSpeed: config.typingSpeed ?? 45,
	autoDelay: config.autoDelay ?? 1600,
	intro: config.intro,
	topics: config.topics,
};
---

<section
	class="home-hero__dialogue"
	aria-label={i18n(I18nKey.characterDialogue)}
	aria-hidden="true"
	data-hero-dialogue
	data-dialogue={JSON.stringify(dialogueConfig)}
	data-hidden="false"
	data-scene-visible="false"
>
	<div class="home-hero__dialogue-layout">
		<HeroSticker config={sticker} />

		<div class="home-hero__dialogue-controls">
			<button type="button" class="home-hero__dialogue-button" data-dialogue-action="back" aria-label={i18n(I18nKey.dialoguePrev)} title={i18n(I18nKey.dialoguePrev)}>
				<Icon name="material-symbols:undo-rounded" is:inline aria-hidden="true" />
				<span>BACK</span>
			</button>
			<button type="button" class="home-hero__dialogue-button" data-dialogue-action="auto" aria-label={i18n(I18nKey.dialogueAutoPlay)} title={i18n(I18nKey.dialogueAutoPlay)} aria-pressed="false">
				<Icon name="material-symbols:play-arrow-rounded" is:inline aria-hidden="true" />
				<span>AUTO</span>
			</button>
			<button type="button" class="home-hero__dialogue-button" data-dialogue-action="hide" aria-label={i18n(I18nKey.collapse)} title={i18n(I18nKey.collapse)}>
				<Icon name="material-symbols:close-rounded" is:inline aria-hidden="true" />
				<span>CLOSE</span>
			</button>
		</div>

		<div class="home-hero__dialogue-box" data-dialogue-box data-speaker="host">
			<div class="home-hero__dialogue-body" data-dialogue-click>
				<div class="home-hero__dialogue-nameplate">
					<span class="home-hero__dialogue-name" data-dialogue-name>{dialogueConfig.speakers.host}</span>
				</div>
				<p class="home-hero__dialogue-text" data-dialogue-text aria-live="polite"></p>
				<ul class="home-hero__dialogue-menu" data-dialogue-menu hidden></ul>
			</div>

			<div class="home-hero__dialogue-footer">
				<button type="button" class="home-hero__dialogue-advance" data-dialogue-advance>
					<span data-dialogue-advance-label>{i18n(I18nKey.dialogueNext)}</span>
					<Icon name="material-symbols:keyboard-arrow-down-rounded" is:inline aria-hidden="true" />
				</button>
			</div>
		</div>
	</div>
</section>
