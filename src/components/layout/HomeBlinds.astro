---
import HomeBlindsScene from "@components/layout/HomeBlindsScene.astro";
import { commentConfig, homeConfig } from "@/config";
import type { HomeBlindsSceneItem } from "@/types/config";

const config = homeConfig.homeBlinds;
const background = config.reveal.backgroundImage;
const isEnabled = config.enabled && Boolean(background);
// 第一层入场标题：标题单行、祝福语单行，逐字拆分供翻转动效使用
const headline = config.reveal.headline;
const headlineMessages = headline.messages.filter(
	(text) => text.trim().length > 0,
);
const sceneItems: HomeBlindsSceneItem[] = [
	{
		...config.scenes.composite,
		image: background,
	},
	...config.scenes.items.slice(0, 4),
];
const standImages = config.scenes.standImages;
/**
 * 拼图背景：SVG 蒙版每周期包含 4 块，凹凸方向交错；
 * 控制器读同一个长度平移整层，循环边界与图案严格重合。
 */
const CYCLE_PERIOD_PX = 224;
/** 气泡槽位上限：控制器按权重排出不重复队列，飘完一条回收再填下一条 */
const BUBBLE_COUNT = 12;
const bubbleMessages = config.scenes.bubbleMessages.filter(
	(message) => (message.text ?? "").trim().length > 0 || Boolean(message.image),
);
/**
 * 评论区那条能不能取，在构建期就判完：只有 Waline 开着才有意义。
 * 判不过就把 enabled 压成 false，客户端一次请求都不会发，运行时不必再猜。
 */
const commentBubble = {
	enabled:
		config.scenes.commentBubble.enabled &&
		commentConfig.type === "waline" &&
		Boolean(commentConfig.waline?.serverURL),
	serverURL: commentConfig.waline?.serverURL ?? "",
	lang: commentConfig.waline?.lang ?? "zh-CN",
	weight: Math.max(1, config.scenes.commentBubble.weight),
};
const runtimeConfig = {
	reveal: {
		headline: {
			enterDuration: headline.enterDuration ?? 0.5,
			messageHold: headline.messageHold ?? 2.6,
			messageFlipDuration: headline.messageFlipDuration ?? 0.62,
		},
	},
	scenes: {
		scrollDistance: config.scenes.scrollDistance,
		sceneCount: sceneItems.length,
		cycleDuration: config.scenes.cycleDuration,
		bubbleMessages,
		commentBubble,
	},
};
---

<div
	class="home-blinds"
	id="home-blinds"
	data-home-blinds-enabled={String(isEnabled)}
	data-pagefind-ignore
>
	<div class="home-blinds__fixed-stage" data-blinds-stage aria-hidden="true">
		<img
			class="home-blinds__background"
			data-home-blinds-src={background}
			alt=""
			decoding="async"
			data-blinds-background
		/>

		<!-- 揭示层全屏磨砂玻璃：压在背景之上、入场标题之下当暗色衬底。
		     显隐与背景由 setupScenes 的 applyPhase 同一次写入，同帧进出不会错闪 -->
		<div class="home-blinds__reveal-glass" data-reveal-glass></div>

		<!-- 入场标题：长条与标题同色，长条内缘退开时标题才「从背面」显露；
		     长条固定在两侧后往外缩放消失，退场随整个揭示层一起上滑 -->
		<div class="home-blinds__headline-window" data-headline-window>
			<div class="home-blinds-headline" data-blinds-headline>
				<span class="home-blinds-headline__ring" data-headline-ring></span>
				<span class="home-blinds-headline__core" data-headline-core>
					<span class="home-blinds-headline__core-ring"></span>
					<!-- 四向刻度整组斜 45°，故单独套一层容器：外层的 rotation 归控制器 -->
					<span class="home-blinds-headline__core-ticks">
						<span class="home-blinds-headline__core-tick" data-core-tick="top"></span>
						<span class="home-blinds-headline__core-tick" data-core-tick="right"></span>
						<span class="home-blinds-headline__core-tick" data-core-tick="bottom"></span>
						<span class="home-blinds-headline__core-tick" data-core-tick="left"></span>
					</span>
				</span>
				<span class="home-blinds-headline__axis" data-headline-axis="left"></span>
				<span class="home-blinds-headline__axis" data-headline-axis="right"></span>
				<span class="home-blinds-headline__edge" data-headline-edge="left"></span>
				<!-- 时间线日期刻度：装饰性 HUD 标记（年份 + 代号），随竖线一同淡入 -->
				<span
					class="home-blinds-headline__edge-dates"
					data-headline-edge-dates="left"
					aria-hidden="true"
				>
					<span class="home-blinds-headline__edge-date" data-edge-date="cross">
						<span class="home-blinds-headline__edge-date-value">1983-3</span>
						<span class="home-blinds-headline__edge-date-code">D</span>
					</span>
					<span class="home-blinds-headline__edge-date-dot" data-edge-date-dot>
					</span>
					<span class="home-blinds-headline__edge-date" data-edge-date="mark">
						<span class="home-blinds-headline__edge-date-value">2035-5</span>
						<span class="home-blinds-headline__edge-date-code">F</span>
					</span>
				</span>
				<span class="home-blinds-headline__edge" data-headline-edge="right"></span>
				<span
					class="home-blinds-headline__edge-dates"
					data-headline-edge-dates="right"
					aria-hidden="true"
				>
					<span class="home-blinds-headline__edge-date" data-edge-date="cross">
						<span class="home-blinds-headline__edge-date-value">1983-3</span>
						<span class="home-blinds-headline__edge-date-code">D</span>
					</span>
					<span class="home-blinds-headline__edge-date-dot" data-edge-date-dot>
					</span>
					<span class="home-blinds-headline__edge-date" data-edge-date="mark">
						<span class="home-blinds-headline__edge-date-value">2035-5</span>
						<span class="home-blinds-headline__edge-date-code">F</span>
					</span>
				</span>

				<div class="home-blinds-headline__stack" data-headline-stack>
					<p class="home-blinds-headline__title" data-headline-title>
						{headline.title}
					</p>
					<div class="home-blinds-headline__messages" data-headline-messages>
						{
							headlineMessages.map((text) => (
								<p class="home-blinds-headline__message" data-headline-message>
									{Array.from(text).map((char) => (
										<span
											class="home-blinds-headline__message-char"
											data-headline-message-char
										>
											{char}
										</span>
									))}
								</p>
							))
						}
					</div>
				</div>

				<span class="home-blinds-headline__band" data-headline-band="left"></span>
				<span class="home-blinds-headline__band" data-headline-band="right"></span>
			</div>
		</div>

		<!-- 全屏背景收缩成首幕画面的过渡层：元素恒为满屏，收缩靠 clip-path 收窗
		     加图片等比 scale -->
		<div class="home-blinds__portal" data-scenes-portal>
			<img
				class="home-blinds__portal-image"
				data-home-blinds-src={background}
				alt=""
				decoding="async"
				data-scenes-portal-image
			/>
		</div>
	</div>

	<section class="home-blinds-reveal" data-home-blinds-reveal aria-label="影像揭示">
		<div class="home-blinds-reveal__viewport"></div>
	</section>

	<section class="home-blinds-scenes" data-home-blinds-scenes aria-label="横向影像叙事">
		<div class="home-blinds-scenes__viewport" data-scenes-viewport>
			<!-- 拼图接缝：单张 SVG 蒙版随整层移动，不为每块拼图建立节点 -->
			<div
				class="home-blinds-scenes__cycle"
				style={`--home-blinds-cycle-period: ${CYCLE_PERIOD_PX}px`}
				aria-hidden="true"
				data-scenes-cycle
			>
				<div
					class="home-blinds-scenes__cycle-track"
					data-scenes-cycle-track
				></div>
			</div>

			<!-- 留言墙：明信片身后一排气泡各自横向飘过，飘出屏幕外那一侧时回收换一条再飘。
			     文案与头像由控制器去重后按权重排序，这里只给等量的空壳 -->
			<div
				class="home-blinds-scenes__bubbles"
				aria-hidden="true"
				data-scenes-bubbles
			>
				{
					Array.from({ length: BUBBLE_COUNT }).map(() => (
						<span class="home-blinds-bubble" data-scene-bubble>
							<span class="home-blinds-bubble__body" data-scene-bubble-body>
								<span
									class="home-blinds-bubble__text"
									data-scene-bubble-text
								/>
								<img
									class="home-blinds-bubble__image"
									data-scene-bubble-image
									alt=""
									loading="lazy"
									decoding="async"
								/>
							</span>
						</span>
					))
				}
			</div>

			<div class="home-blinds-scenes__track" data-scenes-track>
				{
					sceneItems.map((item, index) => (
						<HomeBlindsScene
							index={index}
							item={item}
							composite={index === 0}
						/>
					))
				}
			</div>

			<div class="home-blinds-scenes__stands" data-scenes-stands aria-hidden="true">
				<div class="home-blinds-scenes__stands-track" data-scenes-stands-track>
					{
						standImages.map((image) => (
							<div class="home-blinds-scenes__stand" data-scenes-stand>
								<img
									class="home-blinds-scenes__stand-image"
									data-scenes-stand-image
									src={image}
									alt=""
									loading="lazy"
									decoding="async"
									draggable="false"
								/>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<script
		type="application/json"
		data-home-blinds-config
		is:inline
		set:html={JSON.stringify(runtimeConfig)}
	/>
</div>

<script>
	import {
		bootHomeBlinds,
		teardownHomeBlinds,
	} from "@/utils/home-blinds-controller";
	import { bindHomeLayer } from "@/utils/home-lifecycle";

	// 这一层带 pin、循环动画与可拖拽轨道，必须在 Swup 替换容器之前拆掉，
	// 否则 kill() 会落在已经脱离文档的节点上（同 HomeHero）
	bindHomeLayer("blinds", {
		media: "(min-width: 769px)",
		boot: bootHomeBlinds,
		teardown: teardownHomeBlinds,
	});
</script>
