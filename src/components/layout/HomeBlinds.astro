---
import HomeBlindsScene from "@components/layout/HomeBlindsScene.astro";
import { homeConfig } from "@/config";
import type { HomeBlindsSceneItem } from "@/types/config";

const config = homeConfig.homeBlinds;
const background = config.reveal.backgroundImage;
const isEnabled = config.enabled && Boolean(background);
// 第一层入场标题：标题单行、祝福语单行，逐字拆分供翻转动效使用
const headline = config.reveal.headline;
const headlineMessages = headline.messages.filter(
	(text) => text.trim().length > 0,
);
const sceneItems: HomeBlindsSceneItem[] = [
	{
		...config.scenes.composite,
		image: background,
	},
	...config.scenes.items.slice(0, 4),
];
const standImages = config.scenes.standImages.slice(
	0,
	Math.min(4, Math.max(0, sceneItems.length - 1)),
);
/**
 * 背景跑马灯：单格宽度固定为 CYCLE_CELL_VW，先把列表重复到「一轮 ≥ 一屏宽」，
 * 再整轮复制一份首尾相接，控制器把 xPercent 从 -50 走到 0 即为无缝右移。
 */
const CYCLE_CELL_VW = 38;
const cycleImages = config.scenes.cycleImages.filter(Boolean);
const cyclePass = Math.max(
	1,
	Math.ceil(100 / (Math.max(1, cycleImages.length) * CYCLE_CELL_VW)),
);
const cycleCells = Array.from({ length: cyclePass * 2 }).flatMap(
	() => cycleImages,
);
// 底部进度条为整层共用的一条，始终停在水平中间，由控制器随横移进度连续增减
const sceneTotalLabel = String(sceneItems.length).padStart(2, "0");
const sceneInitialPercent = Math.round(100 / Math.max(1, sceneItems.length));
const runtimeConfig = {
	reveal: {
		foregroundOpacity: config.reveal.foregroundOpacity,
		pointerTravel: config.reveal.pointerTravel,
		headline: {
			enterDuration: headline.enterDuration ?? 0.5,
			messageHold: headline.messageHold ?? 2.6,
			messageFlipDuration: headline.messageFlipDuration ?? 0.62,
		},
	},
	scenes: {
		scrollDistance: config.scenes.scrollDistance,
		sceneCount: sceneItems.length,
		standCount: standImages.length,
		cycleDuration: config.scenes.cycleDuration,
	},
};
---

<div
	class="home-blinds"
	id="home-blinds"
	data-home-blinds-enabled={String(isEnabled)}
	data-pagefind-ignore
>
	<div class="home-blinds__fixed-stage" data-blinds-stage aria-hidden="true">
		<img
			class="home-blinds__background"
			src={background}
			alt=""
			loading="eager"
			decoding="async"
			data-blinds-background
		/>

		<div class="home-blinds__foreground-window" data-reveal-window>
			<img
				class="home-blinds__foreground"
				src={config.reveal.foregroundImage}
				alt=""
				loading="eager"
				decoding="async"
				data-reveal-foreground
			/>
		</div>

		<!-- 入场标题：长条与标题同色，长条内缘退开时标题才「从背面」显露；
		     长条固定在两侧后往外缩放消失，退场随整个揭示层一起上滑 -->
		<div class="home-blinds__headline-window" data-headline-window>
			<div class="home-blinds-headline" data-blinds-headline>
				<span class="home-blinds-headline__ring" data-headline-ring></span>
				<span class="home-blinds-headline__axis" data-headline-axis="left"></span>
				<span class="home-blinds-headline__axis" data-headline-axis="right"></span>
				<span class="home-blinds-headline__edge" data-headline-edge="left"></span>
				<span class="home-blinds-headline__edge" data-headline-edge="right"></span>

				<div class="home-blinds-headline__stack" data-headline-stack>
					<p class="home-blinds-headline__title" data-headline-title>
						{headline.title}
					</p>
					<div class="home-blinds-headline__messages" data-headline-messages>
						{
							headlineMessages.map((text) => (
								<p class="home-blinds-headline__message" data-headline-message>
									{Array.from(text).map((char) => (
										<span
											class="home-blinds-headline__message-char"
											data-headline-message-char
										>
											{char}
										</span>
									))}
								</p>
							))
						}
					</div>
				</div>

				<span class="home-blinds-headline__band" data-headline-band="left"></span>
				<span class="home-blinds-headline__band" data-headline-band="right"></span>
			</div>
		</div>

		<!-- 全屏背景收缩成首幕画面的过渡层，几何尺寸对齐首幕图框 -->
		<div class="home-blinds__portal" data-scenes-portal>
			<img
				class="home-blinds__portal-image"
				src={background}
				alt=""
				decoding="async"
			/>
		</div>
	</div>

	<section class="home-blinds-reveal" data-home-blinds-reveal aria-label="影像揭示">
		<div class="home-blinds-reveal__viewport" data-reveal-viewport></div>
	</section>

	<section class="home-blinds-scenes" data-home-blinds-scenes aria-label="横向影像叙事">
		<div class="home-blinds-scenes__viewport" data-scenes-viewport>
			<!-- 背景跑马灯：与立牌同时以纸牌立起的姿态入场，之后持续从左往右无缝循环 -->
			<div
				class="home-blinds-scenes__cycle"
				style={`--home-blinds-cycle-cell: ${CYCLE_CELL_VW}vw`}
				aria-hidden="true"
				data-scenes-cycle
			>
				<div class="home-blinds-scenes__cycle-track" data-scenes-cycle-track>
					{
						cycleCells.map((image) => (
							<div class="home-blinds-scenes__cycle-cell">
								<img
									class="home-blinds-scenes__cycle-image"
									src={image}
									alt=""
									loading="lazy"
									decoding="async"
								/>
							</div>
						))
					}
				</div>
			</div>

			<svg class="home-blinds-scenes__strings" aria-hidden="true" data-scene-strings>
				{
					standImages.map((_, index) => (
						<line
							class="home-blinds-scenes__string"
							x1="0"
							y1="0"
							x2="0"
							y2="0"
							data-scene-string
							data-string-index={index}
						/>
					))
				}
			</svg>

			<div class="home-blinds-scenes__track" data-scenes-track>
				{
					sceneItems.map((item, index) => (
						<HomeBlindsScene
							index={index}
							total={sceneItems.length}
							item={item}
							composite={index === 0}
						/>
					))
				}
			</div>

			<div
				class="home-blinds-scenes__meter"
				data-scenes-meter
				role="progressbar"
				aria-label="影像进度"
				aria-valuemin="0"
				aria-valuemax="100"
				aria-valuenow={sceneInitialPercent}
			>
				<span class="home-blinds-scenes__meter-index">
					<span data-scenes-meter-ordinal>01</span><span
						class="home-blinds-scenes__meter-total">/{sceneTotalLabel}</span
					>
				</span>
				<span class="home-blinds-scenes__meter-track">
					<span
						class="home-blinds-scenes__meter-fill"
						style={`--home-blinds-scenes-meter: ${sceneInitialPercent / 100}; --home-blinds-scenes-meter-percent: ${sceneInitialPercent}%`}
						data-scenes-meter-fill></span>
				</span>
				<span class="home-blinds-scenes__meter-value" data-scenes-meter-value
					>{sceneInitialPercent}%</span
				>
			</div>

			<div class="home-blinds-scenes__stands" aria-hidden="true">
				{
					standImages.map((image, index) => (
						<div
							class="home-blinds-scenes__stand"
							style={`--home-blinds-stand-index: ${index}`}
							data-scene-stand
							data-stand-index={index}
						>
							<img
								class="home-blinds-scenes__stand-image"
								src={image}
								alt=""
								loading="lazy"
								decoding="async"
								data-scene-stand-image
							/>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<script
		type="application/json"
		data-home-blinds-config
		is:inline
		set:html={JSON.stringify(runtimeConfig)}
	/>
</div>

<script>
	import { bootHomeBlinds } from "@/utils/home-blinds-controller";

	bootHomeBlinds();
	document.addEventListener("astro:page-load", bootHomeBlinds);
</script>
