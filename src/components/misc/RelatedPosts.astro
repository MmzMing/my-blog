---
/**
 * 底部相关文章（文章页许可协议卡之后）。
 * 非加密文章直接用 [...slug] 算好传下的 cards；加密文章 cards 缺省、
 * 由本组件回退自算（HTML 在加密载荷里，解密后才出现，与旧行为一致）。
 * 宽屏（目录面板可见）下整体 display:none，见 related-post-cards.css。
 */
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	getRelatedPostCards,
	type RelatedPostCard,
} from "@/utils/related-posts";
import RelatedPostCards from "./RelatedPostCards.astro";

export interface Props {
	/** 优先使用的卡片数据（[...slug] 一次性算好传下）；缺省时按 currentId 回退自算 */
	cards?: RelatedPostCard[];
	/** 当前文章 id（slug），回退自算时用于排除自身 */
	currentId?: string;
	/** 当前文章标签，回退自算时用于匹配相关度 */
	tags?: string[];
	/** 当前文章分类，回退自算时用于匹配相关度 */
	category?: string;
	/** 返回相关文章数量，默认 3 */
	limit?: number;
}

const {
	cards: provided,
	currentId,
	tags = [],
	category,
	limit = 3,
} = Astro.props;

const cards =
	provided ??
	(currentId
		? await getRelatedPostCards({ currentId, tags, category, limit })
		: []);
---

{
	cards.length > 0 && (
		<section
			class="related-posts related-posts--bottom mb-0 onload-animation"
			aria-label={i18n(I18nKey.relatedPosts)}
		>
			<RelatedPostCards cards={cards} />
		</section>
	)
}
