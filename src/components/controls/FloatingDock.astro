---
import Icon from "@components/common/Icon.astro";
/**
 * 极简悬浮坞 — 替代原 FloatingControls。
 * 桌面端工具默认常驻显示，重组件通过图标按钮打开抽屉。
 */
import { spineModelConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
---

<div class="floating-dock" id="floating-dock">
	<div class="dock-buttons">
		<!-- 目录入口：仅文章详情且宽屏（≥96rem）已有右侧大纲栏时隐藏，见 updatePathDependent -->
		<button class="dock-btn dock-btn-toc hide" id="dock-toc-btn" aria-label={i18n(I18nKey.tableOfContents)} aria-hidden="true" tabindex="-1" type="button" data-tooltip={i18n(I18nKey.tableOfContents)}>
			<span class="dock-btn-icon"><Icon name="material-symbols:format-list-bulleted" class="text-3xl" /></span>
			<span class="dock-btn-label">{i18n(I18nKey.tableOfContents)}</span>
		</button>

		{spineModelConfig?.enable && (
			<button class="dock-btn" id="dock-spine-btn" aria-label={i18n(I18nKey.spineModel)} type="button" data-active="true" data-tooltip={i18n(I18nKey.spineModel)}>
				<span class="dock-btn-icon"><Icon name="material-symbols:image-outline" class="text-3xl" /></span>
				<span class="dock-btn-label">{i18n(I18nKey.spineModel)}</span>
			</button>
		)}

		<button class="dock-btn dock-btn-comment hide" id="dock-comment-btn" aria-label={i18n(I18nKey.comments)} aria-hidden="true" tabindex="-1" type="button" data-tooltip={i18n(I18nKey.comments)}>
			<span class="dock-btn-icon"><Icon name="mingcute:comment-line" class="text-3xl" /></span>
			<span class="dock-btn-label">{i18n(I18nKey.comments)}</span>
		</button>
	</div>

	<button class="dock-btn dock-btn-top hide" id="dock-top-btn" aria-label={i18n(I18nKey.backToTop)} aria-hidden="true" tabindex="-1" type="button" data-tooltip={i18n(I18nKey.backToTop)}>
		<span class="dock-btn-icon"><Icon name="material-symbols:keyboard-arrow-up-rounded" class="text-3xl" /></span>
		<span class="dock-btn-label">{i18n(I18nKey.top)}</span>
	</button>
</div>

{/* 抽屉容器 */}

<div class="dock-drawer dock-drawer-toc dock-drawer-closed" id="dock-drawer-toc">
	<button
		type="button"
		class="dock-drawer-grabber"
		id="dock-toc-grabber"
		aria-label={i18n(I18nKey.expand)}
		aria-expanded="false"
	>
		<span class="dock-drawer-grabber-bar" aria-hidden="true"></span>
	</button>
	<div class="dock-drawer-title">
		<Icon name="material-symbols:format-list-bulleted" class="dock-drawer-title-icon" />
		<span>{i18n(I18nKey.tableOfContents)}</span>
	</div>
	<div class="dock-toc-scroll toc-scroll-container">
		<div id="dock-drawer-toc-content" class="toc-content"></div>
	</div>
</div>

<!-- 样式已迁移至 src/styles/components/floating-dock.css -->

<script>
	import I18nKey from "@/i18n/i18nKey";
	import { i18n } from "@/i18n/translation";
	import { definePersistentIsland, onNavigation } from "@/utils/swup-lifecycle";

	// 悬浮坞在 Swup 容器之外，DOM 与监听跨导航持久存在，只需初始化一次
	definePersistentIsland("floating-dock", () => {
		const dockAbortController = new AbortController();
		const dockSignal = dockAbortController.signal;
		const dock = document.getElementById("floating-dock");
		if (!dock) return;

		const drawers: Record<string, string> = {
			"dock-toc-btn": "dock-drawer-toc",
		};
		/* 目录抽屉：首次打开懒建 TOC，导航后销毁重建（标题集合随页面变化） */
		let dockTocManager: { cleanup: () => void } | null = null;

		const tocDrawer = document.getElementById("dock-drawer-toc");
		const tocGrabber = document.getElementById("dock-toc-grabber") as HTMLButtonElement | null;
		let tocExpanded = false;
		let tocPeekHeight = 0;
		let tocMaxHeight = 0;
		let tocDrag: { pointerId: number; startY: number; startHeight: number; moved: boolean } | null = null;
		let tocDragCleanup: (() => void) | null = null;
		/** 拖拽结束后浏览器补发的 click 需要忽略；触摸端的 click 可能延迟远超过 300ms，不能按时间窗口判断。 */
		let suppressNextTocClick = false;
		let tocCollapseTimer = 0;
		const handledTocClicks = new WeakSet<Event>();

		const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		function updateTocGrabber() {
			if (!tocGrabber) return;
			tocGrabber.setAttribute("aria-expanded", String(tocExpanded));
			tocGrabber.setAttribute("aria-label", i18n(tocExpanded ? I18nKey.collapse : I18nKey.expand));
		}

		function measureTocHeight() {
			if (!tocDrawer) return;

			const height = tocDrawer.style.height;
			const maxHeight = tocDrawer.style.maxHeight;
			const transition = tocDrawer.style.transition;

			tocDrawer.style.transition = "none";
			tocDrawer.style.height = "";
			tocDrawer.style.maxHeight = "";
			void tocDrawer.offsetHeight;

			tocPeekHeight = tocDrawer.offsetHeight;
			const scroll = tocDrawer.querySelector<HTMLElement>(".dock-toc-scroll");
			const extra = scroll ? Math.max(0, scroll.scrollHeight - scroll.clientHeight) : 0;
			tocMaxHeight = Math.min(
				tocPeekHeight + extra,
				Math.max(tocPeekHeight, window.innerHeight * 0.92),
			);

			tocDrawer.style.height = height;
			tocDrawer.style.maxHeight = maxHeight;
			void tocDrawer.offsetHeight;
			tocDrawer.style.transition = transition;
		}

		function updateTocHeight(expanded: boolean, animate = true) {
			if (!tocDrawer) return;

			window.clearTimeout(tocCollapseTimer);
			measureTocHeight();
			const canExpand = tocMaxHeight > tocPeekHeight + 1;
			const nextExpanded = expanded && canExpand;
			const start = tocDrawer.offsetHeight;
			const target = nextExpanded ? tocMaxHeight : tocPeekHeight;

			tocExpanded = nextExpanded;
			updateTocGrabber();

			if (!animate || reduceMotion() || Math.abs(target - start) < 1) {
				tocDrawer.style.maxHeight = nextExpanded ? `${tocMaxHeight}px` : "";
				tocDrawer.style.height = nextExpanded ? `${tocMaxHeight}px` : "";
				return;
			}

			tocDrawer.style.maxHeight = `${tocMaxHeight}px`;
			tocDrawer.style.height = `${start}px`;
			void tocDrawer.offsetHeight;
			tocDrawer.style.height = `${target}px`;

			if (!nextExpanded) {
				// 收起后交还 CSS 的默认高度，避免窗口变矮时残留更大的内联尺寸。
				tocCollapseTimer = window.setTimeout(() => {
					if (!tocDrawer || tocExpanded) return;
					tocDrawer.style.height = "";
					tocDrawer.style.maxHeight = "";
				}, 400);
			}
		}

		function resetTocDrawer() {
			tocExpanded = false;
			window.clearTimeout(tocCollapseTimer);
			tocDragCleanup?.();
			tocDragCleanup = null;
			tocDrag = null;
			if (!tocDrawer) return;
			tocDrawer.removeAttribute("data-dragging");
			tocDrawer.style.height = "";
			tocDrawer.style.maxHeight = "";
			updateTocGrabber();
		}

		function beginTocDrag(event: PointerEvent) {
			const drawer = tocDrawer;
			const grabber = tocGrabber;
			if (!drawer || !grabber) return;

			const drawerEl: HTMLElement = drawer;
			const grabberEl: HTMLButtonElement = grabber;
			if (tocDrag) return;
			if (event.pointerType === "mouse" && event.button !== 0) return;
			if (drawerEl.classList.contains("dock-drawer-closed")) return;

			suppressNextTocClick = false;
			grabberEl.focus({ preventScroll: true });
			measureTocHeight();

			const startHeight = drawerEl.offsetHeight;
			tocDrag = {
				pointerId: event.pointerId,
				startY: event.clientY,
				startHeight,
				moved: false,
			};
			drawerEl.setAttribute("data-dragging", "");
			drawerEl.style.maxHeight = `${tocMaxHeight}px`;
			drawerEl.style.height = `${startHeight}px`;

			try {
				grabberEl.setPointerCapture(event.pointerId);
			} catch {
				// 指针已经离开，窗口级监听仍然能接住后续移动
			}

			function move(moveEvent: PointerEvent) {
				if (!tocDrag || moveEvent.pointerId !== tocDrag.pointerId) return;
				const delta = tocDrag.startY - moveEvent.clientY;
				if (!tocDrag.moved && Math.abs(delta) > 3) {
					tocDrag.moved = true;
					if (moveEvent.cancelable) moveEvent.preventDefault();
				}
				const next = Math.min(
					Math.max(tocDrag.startHeight + delta, tocPeekHeight),
					tocMaxHeight,
				);
				drawerEl.style.height = `${next}px`;
			}

			function cleanup() {
				window.removeEventListener("pointermove", move);
				window.removeEventListener("pointerup", onUp);
				window.removeEventListener("pointercancel", onCancel);
				tocDragCleanup = null;
			}

			function finish(endEvent: PointerEvent, cancelled = false) {
				if (!tocDrag || endEvent.pointerId !== tocDrag.pointerId) return;

				const drag = tocDrag;
				tocDrag = null;
				cleanup();
				drawerEl.removeAttribute("data-dragging");
				try {
					if (grabberEl.hasPointerCapture(endEvent.pointerId)) {
						grabberEl.releasePointerCapture(endEvent.pointerId);
					}
				} catch {
					// 指针已经释放
				}

				suppressNextTocClick = true;
				if (cancelled) {
					updateTocHeight(tocExpanded, true);
					return;
				}

				const heightDelta = Math.abs(drawerEl.offsetHeight - drag.startHeight);
				if (!drag.moved || heightDelta <= 6) {
					updateTocHeight(!tocExpanded, true);
					return;
				}

				const threshold = tocPeekHeight + (tocMaxHeight - tocPeekHeight) * 0.35;
				updateTocHeight(drawerEl.offsetHeight > threshold, true);
			}

			function onUp(upEvent: PointerEvent) {
				finish(upEvent);
			}

			function onCancel(cancelEvent: PointerEvent) {
				finish(cancelEvent, true);
			}

			tocDragCleanup = cleanup;
			window.addEventListener("pointermove", move);
			window.addEventListener("pointerup", onUp);
			window.addEventListener("pointercancel", onCancel);
		}

		async function ensureDockToc() {
			const tocContent = document.getElementById("dock-drawer-toc-content");
			if (!tocContent) return;
			dockTocManager?.cleanup();
			dockTocManager = null;
			try {
				const { TOCManager } = await import("@/utils/toc-utils");
				const manager = new TOCManager({
					contentId: "dock-drawer-toc-content",
					indicatorId: "dock-drawer-toc-indicator",
					maxLevel: 3,
					scrollOffset: 80,
				});
				manager.init();
				dockTocManager = manager;
			} catch {
				tocContent.textContent = i18n(I18nKey.tocEmpty);
			}
		}

		function closeAllDrawers() {
			document.querySelectorAll(".dock-drawer").forEach((drawer) => {
				drawer.classList.add("dock-drawer-closed");
				if (drawer.id === "dock-drawer-toc") {
					window.setTimeout(() => {
						if (drawer.classList.contains("dock-drawer-closed")) resetTocDrawer();
					}, 340);
				}
			});
		}

		function setButtonVisibility(id: string, visible: boolean) {
			const button = document.getElementById(id);
			if (!button) return;
			button.classList.toggle("hide", !visible);
			button.setAttribute("aria-hidden", String(!visible));
			button.setAttribute("tabindex", visible ? "0" : "-1");
		}

		Object.entries(drawers).forEach(([buttonId, drawerId]) => {
			const button = document.getElementById(buttonId);
			const drawer = document.getElementById(drawerId);
			if (!button || !drawer) return;
			button.addEventListener("click", async (event) => {
				event.stopPropagation();
				const isOpen = !drawer.classList.contains("dock-drawer-closed");
				closeAllDrawers();
				if (!isOpen) {
					// 先建好目录再打开：否则首次打开时卡片高度会从空列表长到完整高度，
					// 底边固定会看到顶边跳一下，底部上滑的动画不再连贯。
					if (drawerId === "dock-drawer-toc") {
						await ensureDockToc();
						resetTocDrawer();
						measureTocHeight();
					}
					drawer.classList.remove("dock-drawer-closed");
				}
			}, { signal: dockSignal });
		});

		if (tocGrabber && tocDrawer) {
			tocGrabber.addEventListener("click", (event) => {
				if (handledTocClicks.has(event)) return;
				handledTocClicks.add(event);
				event.stopPropagation();
				if (suppressNextTocClick) {
					suppressNextTocClick = false;
					return;
				}
				updateTocHeight(!tocExpanded, true);
			}, { signal: dockSignal });

			tocGrabber.addEventListener("keydown", (event) => {
				if (event.key === "Enter" || event.key === " ") {
					suppressNextTocClick = false;
				}
				if (event.key === "ArrowUp" || event.key === "Home") {
					event.preventDefault();
					updateTocHeight(true, true);
				} else if (event.key === "ArrowDown" || event.key === "End") {
					event.preventDefault();
					updateTocHeight(false, true);
				}
			}, { signal: dockSignal });

			tocGrabber.addEventListener("pointerdown", beginTocDrag, { signal: dockSignal });
			updateTocGrabber();
		}

		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Node)) return;
			const isInDrawer = document.querySelector(".dock-drawer:not(.dock-drawer-closed)")?.contains(target);
			if (!isInDrawer && !dock.contains(target)) closeAllDrawers();
		}, { signal: dockSignal });

		// Spine 显隐切换
		function bindSpineToggle(btnId: string, targetId: string, storageKey: string) {
			const button = document.getElementById(btnId);
			const target = document.getElementById(targetId);
			if (!button || !target) return;

			const savedHidden = localStorage.getItem(storageKey) === "true";
			if (savedHidden) {
				(target as HTMLElement).style.display = "none";
				button.setAttribute("data-active", "false");
			}

			button.addEventListener("click", (event) => {
				event.stopPropagation();
				const isHidden = (target as HTMLElement).style.display === "none";
				(target as HTMLElement).style.display = isHidden ? "" : "none";
				button.setAttribute("data-active", String(isHidden));
				localStorage.setItem(storageKey, String(!isHidden));
			}, { signal: dockSignal });
		}
		bindSpineToggle("dock-spine-btn", "spine-model-container", "spine-hidden");

		document.getElementById("dock-top-btn")?.addEventListener("click", (event) => {
			event.stopPropagation();
			window.scroll({ top: 0, behavior: "smooth" });
		}, { signal: dockSignal });
		document.getElementById("dock-comment-btn")?.addEventListener("click", (event) => {
			event.stopPropagation();
			document.getElementById("post-comments")?.scrollIntoView({ behavior: "smooth", block: "start" });
		}, { signal: dockSignal });
		function updateScrollDependent() {
			const topButton = document.getElementById("dock-top-btn");
			if (!topButton) return;
			const visible = window.scrollY > 200;
			topButton.classList.toggle("hide", !visible);
			topButton.setAttribute("aria-hidden", String(!visible));
			topButton.setAttribute("tabindex", visible ? "0" : "-1");
		}

		function updatePathDependent() {
			const pathname = window.location.pathname;
			const isPost = /\/posts?\//.test(pathname);
			const isFriends = /^\/friends\/?$/.test(pathname);
			const hasComment = !!document.getElementById("post-comments");

			setButtonVisibility("dock-comment-btn", (isPost || isFriends) && hasComment);
			/* 目录按钮：文章详情且宽屏（≥96rem）已有大纲栏时隐藏 */
			const tocDrawerOpen = !document.getElementById("dock-drawer-toc")?.classList.contains("dock-drawer-closed");
			const showToc = isPost && !window.matchMedia("(min-width: 96rem)").matches;
			setButtonVisibility("dock-toc-btn", showToc);
			if (!showToc && tocDrawerOpen) closeAllDrawers();
		}

		updateScrollDependent();
		updatePathDependent();
		window.addEventListener("scroll", updateScrollDependent, { passive: true, signal: dockSignal });
		// 跨过 96rem 断点时目录按钮显隐/抽屉状态需要重算
		window.addEventListener("resize", updatePathDependent, { passive: true, signal: dockSignal });
		window.addEventListener("resize", () => {
			if (!tocDrawer || tocDrawer.classList.contains("dock-drawer-closed") || tocDrag) return;
			measureTocHeight();
			if (tocExpanded) {
				tocDrawer.style.maxHeight = `${tocMaxHeight}px`;
				tocDrawer.style.height = `${tocMaxHeight}px`;
			}
		}, { passive: true, signal: dockSignal });
		// 只在导航后收抽屉、重算路径相关按钮；首次加载的初始态由上面两行直接调用负责
		onNavigation(() => {
			closeAllDrawers();
			dockTocManager?.cleanup();
			dockTocManager = null;
			updatePathDependent();
			updateScrollDependent();
		}, { signal: dockSignal });
	});
</script>
