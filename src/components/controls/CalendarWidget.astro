---
import Icon from "@components/common/Icon.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	id: string;
	class?: string;
}

const { id, class: className } = Astro.props;
const titleId = `${id}-title`;
const holidayLabelId = `${id}-holiday-label`;
const birthdayLabelId = `${id}-birthday-label`;
---

<section
	id={id}
	class:list={["calendar-widget", className]}
	data-calendar-widget
	data-calendar-state="idle"
	aria-busy="true"
	aria-label={i18n(I18nKey.calendar)}
>
	<header class="calendar-widget__header">
		<Icon name="material-symbols:calendar-month-rounded" class="calendar-widget__title-icon" aria-hidden="true" />
		<h2 id={titleId} class="calendar-widget__title">{i18n(I18nKey.calendar)}</h2>
		<button
			class="calendar-widget__view-toggle"
			type="button"
			data-calendar-view-toggle
			aria-label={i18n(I18nKey.calendarSwitch)}
			aria-pressed="false"
			title={i18n(I18nKey.calendarSwitch)}
		>
			{i18n(I18nKey.calendarSwitch)}
		</button>
	</header>

	<section class="calendar-widget__calendar-area" aria-labelledby={titleId}>
		<div class="calendar-widget__view-panel" data-calendar-view-panel="overview">
			<header class="calendar-widget__today">
				<div>
					<p class="calendar-widget__eyebrow" data-calendar-today-label>{i18n(I18nKey.calendarLoading)}</p>
					<p class="calendar-widget__weekday" data-calendar-weekday></p>
				</div>
				<strong class="calendar-widget__day" data-calendar-day>--</strong>
			</header>

			<ul class="calendar-widget__week" aria-label={i18n(I18nKey.calendarToday)} data-calendar-week></ul>
		</div>

		<section class="calendar-widget__view-panel" data-calendar-view-panel="published" aria-label={i18n(I18nKey.calendarPublished)} hidden>
			<div class="calendar-widget__month-nav">
				<button
					class="calendar-widget__icon-button"
					type="button"
					data-calendar-month="previous"
					aria-label={i18n(I18nKey.prevMonth)}
					title={i18n(I18nKey.prevMonth)}
				>
					<Icon name="material-symbols:chevron-left" is:inline />
				</button>
				<div class="calendar-widget__month-current">
					<p class="calendar-widget__month-label" data-calendar-month-label aria-live="polite"></p>
					<button
						class="calendar-widget__today-button"
						type="button"
						data-calendar-today-button
						aria-label={i18n(I18nKey.calendarToday)}
						title={i18n(I18nKey.calendarToday)}
					>
						<Icon name="material-symbols:today" is:inline />
					</button>
				</div>
				<button
					class="calendar-widget__icon-button"
					type="button"
					data-calendar-month="next"
					aria-label={i18n(I18nKey.nextMonth)}
					title={i18n(I18nKey.nextMonth)}
				>
					<Icon name="material-symbols:chevron-right" is:inline />
				</button>
			</div>

			<div class="calendar-widget__month-weekdays" data-calendar-month-weekdays></div>
			<div class="calendar-widget__month-grid" role="grid" data-calendar-month-grid></div>

			<section class="calendar-widget__posts" aria-live="polite">
				<p class="calendar-widget__posts-title" data-calendar-posts-title>{i18n(I18nKey.calendarLoading)}</p>
				<div class="calendar-widget__post-list" data-calendar-post-list></div>
			</section>
		</section>
	</section>

	<section class="calendar-widget__event-area" aria-live="polite">
		<div class="calendar-widget__events">
			<article class="calendar-widget__event" data-calendar-event="holiday">
				<div class="calendar-widget__event-main">
					<div class="calendar-widget__event-copy">
						<p id={holidayLabelId}>{i18n(I18nKey.calendarNextHoliday)}</p>
						<strong data-calendar-event-title>{i18n(I18nKey.calendarLoading)}</strong>
					</div>
					<time class="calendar-widget__event-date" data-calendar-event-date></time>
				</div>
				<div class="calendar-widget__event-progress-row">
					<span class="calendar-widget__event-percent" data-calendar-event-percent>--</span>
					<span
						class="calendar-widget__progress"
						role="progressbar"
						aria-labelledby={holidayLabelId}
						aria-valuemin="0"
						aria-valuemax="100"
						aria-valuenow="0"
						data-calendar-event-progress
					>
						<span data-calendar-event-progress-fill></span>
					</span>
					<span class="calendar-widget__event-remaining" data-calendar-event-remaining>--</span>
				</div>
			</article>

			<article class="calendar-widget__event" data-calendar-event="birthday">
				<div class="calendar-widget__event-main">
					<div class="calendar-widget__event-copy">
						<p id={birthdayLabelId}>{i18n(I18nKey.calendarNextBirthday)}</p>
						<strong data-calendar-event-title>{i18n(I18nKey.calendarLoading)}</strong>
					</div>
					<time class="calendar-widget__event-date" data-calendar-event-date></time>
				</div>
				<div class="calendar-widget__event-progress-row">
					<span class="calendar-widget__event-percent" data-calendar-event-percent>--</span>
					<span
						class="calendar-widget__progress"
						role="progressbar"
						aria-labelledby={birthdayLabelId}
						aria-valuemin="0"
						aria-valuemax="100"
						aria-valuenow="0"
						data-calendar-event-progress
					>
						<span data-calendar-event-progress-fill></span>
					</span>
					<span class="calendar-widget__event-remaining" data-calendar-event-remaining>--</span>
				</div>
			</article>
		</div>

		<div class="calendar-widget__countdowns" aria-live="off">
			<div class="calendar-widget__countdown">
				<span>{i18n(I18nKey.calendarMonthRemaining)}</span>
				<strong data-calendar-month-remaining>--</strong>
			</div>
			<div class="calendar-widget__countdown">
				<span>{i18n(I18nKey.calendarYearRemaining)}</span>
				<strong data-calendar-year-remaining>--</strong>
			</div>
		</div>
	</section>
</section>
