---
import Icon from "@components/common/Icon.astro";

interface TechItem {
	name: string;
	desc: string;
	icon: string;
	url: string;
	color: string;
	darkColor?: string;
}

interface TechGroup {
	id: string;
	label: string;
	icon: string;
	items: TechItem[];
}

