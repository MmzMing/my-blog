				desc: "数据可视化与关系图谱",
				icon: "simple-icons:d3",
				url: "https://d3js.org",
				color: "#f9a03c",
			},
			{
				name: "Pagefind",
				desc: "静态全文搜索",
				icon: "material-symbols:search",
				url: "https://pagefind.app",
				color: "#2563eb",
			},
		],
	},
	{
		id: "content",
		label: "内容与渲染",
		icon: "material-symbols:terminal",
		items: [
			{
				name: "MDX",
				desc: "关于页的组件化内容",
				icon: "simple-icons:mdx",
				url: "https://mdxjs.com",
				color: "#f9ac00",
			},
			{
