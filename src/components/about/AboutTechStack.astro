				url: "https://biomejs.dev",
				color: "#6f7bf7",
			},
			{
				name: "Vitest",
				desc: "单元测试",
				icon: "simple-icons:vitest",
				url: "https://vitest.dev",
				color: "#6da918",
			},
			{
				name: "Playwright",
				desc: "端到端测试",
				icon: "simple-icons:playwright",
				url: "https://playwright.dev",
				color: "#2ead33",
			},
			{
				name: "GitHub Actions",
				desc: "CI 流水线",
