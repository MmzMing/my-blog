---
import { topicDefinitions } from "@/config/topics";
---

<section class="mx-auto mt-12 w-full max-w-5xl px-4" aria-labelledby="topic-index-title">
	<div class="mb-5 flex items-end justify-between gap-4">
		<div>
			<p class="text-xs tracking-[0.24em] text-(--content-meta)">KNOWLEDGE MAP</p>
			<h2 id="topic-index-title" class="mt-2 text-2xl font-bold">主题知识库</h2>
		</div>
		<a class="text-sm text-(--primary) hover:underline" href="/topics/">查看全部主题</a>
	</div>
	<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		{topicDefinitions.map((topic) => (
			<a
				href={`/topics/${topic.slug}/`}
				class="card-base block rounded-(--radius-large) p-5 transition-transform hover:-translate-y-0.5"
			>
				<h3 class="text-lg font-semibold">{topic.title}</h3>
				<p class="mt-2 text-sm leading-6 text-(--content-meta)">{topic.description}</p>
			</a>
		))}
	</div>
</section>
