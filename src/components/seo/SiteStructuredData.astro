---
import { homeConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	buildOrganizationEntity,
	buildPersonEntity,
	buildWebSiteEntity,
	serializeJsonLd,
} from "@/utils/schema-utils";

interface Props {
	includeProfilePage?: boolean;
}

const { includeProfilePage = false } = Astro.props;

const siteUrl = new URL("/", Astro.site).toString();
const aboutUrl = new URL("/about/", Astro.site).toString();

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		buildWebSiteEntity(Astro.site),
		buildPersonEntity(Astro.site),
		buildOrganizationEntity(Astro.site),
		...(includeProfilePage
			? [
					{
						"@type": "ProfilePage",
						"@id": `${aboutUrl}#profilepage`,
						url: aboutUrl,
						name: `${i18n(I18nKey.aboutSitePrefix)} ${homeConfig.name}`,
						isPartOf: { "@id": `${siteUrl}#website` },
						mainEntity: { "@id": `${siteUrl}#person` },
					},
				]
			: []),
	],
};
---

<script
	is:inline
	type="application/ld+json"
	set:html={serializeJsonLd(structuredData)}
></script>
