---
import { homeConfig, siteConfig } from "@/config";

const siteUrl = new URL("/", Astro.site).toString();
const aboutUrl = new URL("/about/", Astro.site).toString();
const imageUrl = new URL(
	siteConfig.defaultOgImage || "/assets/images/aut.webp",
	Astro.site,
).toString();
const sameAs = homeConfig.links
	.filter((link) => /^https?:\/\//i.test(link.url))
	.map((link) => link.url);

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteUrl}#website`,
			url: siteUrl,
			name: siteConfig.title,
			description: siteConfig.description,
			inLanguage: siteConfig.lang.replace("_", "-"),
			publisher: { "@id": `${siteUrl}#person` },
		},
		{
			"@type": ["Person", "Author"],
			"@id": `${siteUrl}#person`,
			name: homeConfig.name,
			url: aboutUrl,
			description:
				"MmzMing，专注 Java、AI、Astro、Redis、认证安全与个人站点工程实践的开发者。",
			image: imageUrl,
			jobTitle: "全栈工程师 / 技术博主",
			knowsAbout: ["Java", "AI", "Astro", "Redis", "认证安全", "Cloudflare"],
			sameAs,
		},
		{
			"@type": "ProfilePage",
			"@id": `${aboutUrl}#profilepage`,
			url: aboutUrl,
			name: `关于 ${homeConfig.name}`,
			isPartOf: { "@id": `${siteUrl}#website` },
			mainEntity: { "@id": `${siteUrl}#person` },
		},
	],
};
---

<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
></script>
