---
import { homeConfig, siteConfig } from "@/config";

interface Props {
	includeProfilePage?: boolean;
}

const { includeProfilePage = false } = Astro.props;

const siteUrl = new URL("/", Astro.site).toString();
const aboutUrl = new URL("/about/", Astro.site).toString();
const imageUrl = new URL(
	siteConfig.defaultOgImage || "/assets/images/aut.webp",
	Astro.site,
).toString();
const sameAs = homeConfig.links
	.filter((link) => /^https?:\/\//i.test(link.url))
	.map((link) => link.url);

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteUrl}#website`,
			url: siteUrl,
			name: siteConfig.title,
			description: siteConfig.description,
			inLanguage: siteConfig.lang.replace("_", "-"),
			publisher: { "@id": `${siteUrl}#organization` },
		},
		{
			"@type": ["Person", "Author"],
			"@id": `${siteUrl}#person`,
			name: homeConfig.name,
			url: aboutUrl,
			description: siteConfig.description,
			image: imageUrl,
			jobTitle: homeConfig.occupation,
			knowsAbout: siteConfig.keywords,
			sameAs,
		},
		{
			"@type": "Organization",
			"@id": `${siteUrl}#organization`,
			name: siteConfig.title,
			url: siteUrl,
			logo: {
				"@type": "ImageObject",
				"@id": `${siteUrl}#logo`,
				url: imageUrl,
			},
			sameAs,
		},
		...(includeProfilePage ? [{
			"@type": "ProfilePage",
			"@id": `${aboutUrl}#profilepage`,
			url: aboutUrl,
			name: `关于 ${homeConfig.name}`,
			isPartOf: { "@id": `${siteUrl}#website` },
			mainEntity: { "@id": `${siteUrl}#person` },
		}] : []),
	],
};
---

<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
></script>
