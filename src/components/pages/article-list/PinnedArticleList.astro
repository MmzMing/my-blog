---
import CoverImage from "@/components/common/CoverImage.astro";
import Icon from "@/components/common/Icon.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { ArticleListPost } from "@/types/article-list";

interface Props {
	posts: ArticleListPost[];
	fallbackImageUrl: string;
	showCoverLoading?: boolean;
}

const { posts, fallbackImageUrl, showCoverLoading = false } = Astro.props;
---

{posts.length > 0 && (
	<section class="article-list-pinned" data-article-list-pinned aria-labelledby="article-list-pinned-title">
		<h2 id="article-list-pinned-title" class="article-list-section-title article-list-pinned__heading">
			{i18n(I18nKey.pinned)}
		</h2>
		<div class="article-list-pinned__collection" data-article-list-pinned-carousel>
			{posts.map((post, index) => {
				const wordLabel = i18n(
					post.wordCount === 1 ? I18nKey.wordCount : I18nKey.wordsCount,
				);
				const visibleTags = post.tags.slice(0, 3);
				const hiddenTagCount = post.tags.length - visibleTags.length;
				return (
					<article
						class="article-list-pinned-item"
						data-article-list-pinned-item
						hidden={index !== 0}
					>
						<div class="article-list-pinned-item__content">
							<div class="article-list-pinned-item__title-row">
								<h3 class="article-list-pinned-item__title">
									<span class="article-list-pinned-item__title-text" title={post.title}>
										{post.title}
										{post.password && (
											<Fragment>
												<span class="article-list-pinned-item__lock" aria-hidden="true">
													<Icon name="material-symbols:lock-outline" width="1em" height="1em" />
												</span>
												<span class="sr-only">{i18n(I18nKey.encryptedPost)}</span>
											</Fragment>
										)}
									</span>
								</h3>
							</div>
							<div class="article-list-pinned-item__meta">
								<span
									class="article-list-pinned-item__taxonomy article-list-pinned-item__taxonomy--category"
									style={`--article-category-hue: ${post.categoryHue}`}
								>
									{post.category}
								</span>
								<span class="article-list-pinned-item__meta-item" title={i18n(I18nKey.viewsLabel)}>
									<Icon name="material-symbols:visibility-outline-rounded" width="1em" height="1em" />
									<span class="sr-only">{i18n(I18nKey.viewsLabel)}</span>
									<span data-article-list-pageview data-article-list-pageview-path={post.url}>-</span>
								</span>
								<span class="article-list-pinned-item__meta-item">
									<Icon name="material-symbols:calendar-month-rounded" width="1em" height="1em" />
									<span class="sr-only">{i18n(I18nKey.publishDatePrefix)}</span>
									<time datetime={post.publishedIso}>{post.publishedText}</time>
								</span>
								<span class="article-list-pinned-item__meta-item">
									<Icon name="material-symbols:article-outline-rounded" width="1em" height="1em" />
									<span>{post.wordCount.toLocaleString()} {wordLabel}</span>
								</span>
								{visibleTags.map((tag) => (
									<span class="article-list-pinned-item__taxonomy article-list-pinned-item__taxonomy--tag">
										{tag}
									</span>
								))}
								{hiddenTagCount > 0 && (
									<span class="article-list-pinned-item__tag-overflow">+{hiddenTagCount}</span>
								)}
							</div>
							<p class="article-list-pinned-item__description">{post.description}</p>
						</div>
						{post.cover && (
							<div
								class="article-list-pinned-item__cover-wrap image-pixel-reveal-host"
								style={post.cover.lqipStyle}
								data-article-list-cover-wrap
							>
								{showCoverLoading && (
									<span class="article-list-pinned-item__cover-loader" aria-hidden="true">
										<span class="article-list-pinned-item__cover-loader-dot"></span>
										<span class="article-list-pinned-item__cover-loader-dot"></span>
										<span class="article-list-pinned-item__cover-loader-dot"></span>
										<span class="article-list-pinned-item__cover-loader-dot"></span>
									</span>
								)}
								<span class="image-pixel-reveal" data-image-pixel-reveal aria-hidden="true"></span>
								<CoverImage
									cover={post.cover}
									alt={`${post.title}${i18n(I18nKey.coverImageAltSuffix)}`}
									class="article-list-pinned-item__cover image-pixel-reveal-source"
									loading={index === 0 ? "eager" : "lazy"}
									fetchpriority={index === 0 ? "high" : "auto"}
									apiUrls={post.apiUrls}
									fallbackSrc={fallbackImageUrl || undefined}
								/>
							</div>
						)}
						<a
							href={post.url}
							class="article-list-pinned-item__surface-link"
							aria-label={`${i18n(I18nKey.viewPostPrefix)}${post.title}`}
							title={post.title}
						></a>
					</article>
				);
			})}
		</div>
		{posts.length > 1 && (
			<div class="article-list-pinned__dots" aria-label={i18n(I18nKey.switchPinnedAria)}>
				{posts.map((post, index) => (
					<button
						type="button"
						data-article-list-pinned-dot
						aria-label={`${i18n(I18nKey.viewPinnedPostPrefix)}${post.title}`}
						aria-current={index === 0 ? "true" : undefined}
					></button>
				))}
			</div>
		)}
	</section>
)}
