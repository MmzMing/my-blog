---
import { render } from "astro:content";
import path from "node:path";
import PageTitle from "@/components/common/PageTitle.astro";
import ArticleList from "@/components/pages/article-list/ArticleList.astro";
import { siteConfig } from "@/config";
import { coverImageConfig } from "@/config/coverImageConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import type { ArticleListPost } from "@/types/article-list";
import { getSortedPosts } from "@/utils/content-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getPostUrlBySlug, url } from "@/utils/url-utils";

interface Props {
	currentPage?: number;
}

const { currentPage = 1 } = Astro.props;
const allPosts = await getSortedPosts();
const pinnedEntries = allPosts.filter((entry) => entry.data.pinned);
const regularEntries = allPosts.filter((entry) => !entry.data.pinned);
const postsPerPage = Math.max(
	1,
	Math.floor(siteConfig.pagination.postsPerPage),
);
const totalPages = Math.max(1, Math.ceil(regularEntries.length / postsPerPage));
const resolvedPage = Math.max(
	1,
	Math.min(totalPages, Math.floor(currentPage) || 1),
);
const startIndex = (resolvedPage - 1) * postsPerPage;
const pageEntries = regularEntries.slice(startIndex, startIndex + postsPerPage);
const fallbackImageUrl = url(
	coverImageConfig.randomCoverImage.fallback || "/assets/images/aut.webp",
);
const showCoverLoading = coverImageConfig.randomCoverImage.showLoading ?? true;
const postImageFiles = import.meta.glob<ImageMetadata>(
	"../../../content/posts/**/*.{png,jpg,jpeg,webp,avif,gif}",
	{ import: "default" },
);
const dateFormatter = new Intl.DateTimeFormat(
	siteConfig.lang.replace("_", "-"),
	{
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	},
);

function getCategoryHue(category: string): number {
	let hash = 2166136261;
	for (let index = 0; index < category.length; index++) {
		hash ^= category.charCodeAt(index);
		hash = Math.imul(hash, 16777619);
	}
	return (hash >>> 0) % 360;
}

async function resolvePostImage(
	entry: (typeof allPosts)[number],
): Promise<string> {
	const processedImage = processCoverImageSync(entry.data.image, entry.id);
	if (!processedImage) return fallbackImageUrl;

	if (processedImage.startsWith("/")) return url(processedImage);
	if (processedImage.startsWith("http") || processedImage.startsWith("data:")) {
		return processedImage;
	}

	const basePath = getFileDirFromPath(entry.filePath || "");
	const normalizedPath = path
		.normalize(path.join("../../../", basePath, processedImage))
		.replace(/\\/g, "/");
	const localImage = postImageFiles[normalizedPath];
	if (!localImage) return fallbackImageUrl;

	const metadata = await localImage();
	return metadata.src;
}

async function createArticleListPost(
	entry: (typeof allPosts)[number],
): Promise<ArticleListPost> {
	const [{ remarkPluginFrontmatter }, imageUrl] = await Promise.all([
		render(entry),
		resolvePostImage(entry),
	]);
	const rawCategory = entry.data.category?.trim();
	const category = rawCategory || i18n(I18nKey.uncategorized);
	const tags = (entry.data.tags || []).map((tag) => tag.trim()).filter(Boolean);

	return {
		id: entry.id,
		title: entry.data.title,
		url: getPostUrlBySlug(entry.id),
		publishedIso: entry.data.published.toISOString(),
		publishedTimestamp: entry.data.published.getTime(),
		publishedText: dateFormatter.format(entry.data.published),
		category,
		categoryHue: getCategoryHue(category),
		tags,
		description:
			entry.data.description ||
			remarkPluginFrontmatter.excerpt ||
			i18n(I18nKey.noDescriptionFallback),
		pinned: !!entry.data.pinned,
		password: !!entry.data.password,
		wordCount: Number(remarkPluginFrontmatter.words) || 0,
		imageUrl,
		apiUrls: getApiUrlList(entry.data.image, entry.id),
	};
}

const [pinnedPosts, regularPosts] = await Promise.all([
	Promise.all(pinnedEntries.map(createArticleListPost)),
	Promise.all(pageEntries.map(createArticleListPost)),
]);
const baseTitle = i18n(I18nKey.postList);
const baseDescription = i18n(I18nKey.listDescription);
const pageStatus = i18n(I18nKey.paginationStatus)
	.replace("{current}", String(resolvedPage))
	.replace("{total}", String(totalPages));
const title = resolvedPage === 1 ? baseTitle : `${baseTitle} - ${pageStatus}`;
const description =
	resolvedPage === 1 ? baseDescription : `${baseDescription} ${pageStatus}`;
const umamiConfig = siteConfig.analytics?.umamiAnalytics;
const umamiPageviews = {
	enabled:
		!!umamiConfig?.pageviews?.enabled &&
		!!umamiConfig.shareId &&
		!!umamiConfig.scriptUrl,
	apiBase: umamiConfig?.scriptUrl ? new URL(umamiConfig.scriptUrl).origin : "",
	shareId: umamiConfig?.shareId || "",
};
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
	<section class="article-list-page z-10 px-4 py-6 md:px-9 relative w-full">
		<header class="article-list-page__header">
			<PageTitle title={baseTitle} variant="stacked" />
		</header>

		<ArticleList
			pinnedPosts={pinnedPosts}
			regularPosts={regularPosts}
			totalPosts={allPosts.length}
			currentPage={resolvedPage}
			totalPages={totalPages}
			umamiPageviews={umamiPageviews}
			fallbackImageUrl={fallbackImageUrl}
			showCoverLoading={showCoverLoading}
		/>
	</section>
</MainGridLayout>
