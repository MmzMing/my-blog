---
interface PicItem {
	src: string;
	alt?: string;
	caption?: string;
}

interface Props {
	src?: string;
	caption?: string;
	mirror?: boolean | string;
	full?: boolean | string;
	items?: Array<PicItem | string> | string;
	layout?: string;
	loading?: "lazy" | "eager";
	maxWidth?: string;
}

const galleryLayouts = ["duo", "feature", "stack"] as const;
type GalleryLayout = (typeof galleryLayouts)[number];

const {
	src,
	caption,
	mirror = false,
	full = false,
	items,
	layout = "duo",
	loading = "lazy",
	maxWidth,
} = Astro.props;
const isMirror = mirror === true || mirror === "true";
const isFull = full === true || full === "true";
const singleMaxWidth =
	typeof maxWidth === "string" && maxWidth.trim().length > 0
		? maxWidth.trim()
		: null;
const singleStyle = singleMaxWidth
	? `max-width: min(100%, ${singleMaxWidth})`
	: undefined;
const galleryLayout = galleryLayouts.includes(layout as GalleryLayout)
	? (layout as GalleryLayout)
	: "duo";
const rawItems: unknown = Array.isArray(items)
	? items
	: typeof items === "string"
		? (() => {
				try {
					return JSON.parse(items);
				} catch {
					return [];
				}
			})()
		: [];
const galleryItems = (Array.isArray(rawItems) ? rawItems : [])
	.map((item) => (typeof item === "string" ? { src: item } : item))
	.filter((item): item is PicItem => {
		if (!item || typeof item !== "object" || !("src" in item)) return false;
		return typeof item.src === "string" && item.src.length > 0;
	});
const singleSrc = src || galleryItems[0]?.src;
const singleCaption = caption || galleryItems[0]?.caption;
const showGallery = galleryItems.length > 1;
---

{
	showGallery && (
		<div
			class:list={[
				"mdx-pic-gallery",
				`mdx-pic-gallery--${galleryLayout}`,
			]}
		>
			{galleryItems.map((item) => (
				<figure class="mdx-pic-gallery__item">
					<img
						class="mdx-pic-gallery__image"
						src={item.src}
						alt={item.alt || item.caption || ""}
						loading={loading}
						decoding="async"
					/>
					{item.caption && (
						<figcaption class="mdx-pic-gallery__caption">
							{item.caption}
						</figcaption>
					)}
				</figure>
			))}
		</div>
	)
}

{
	!showGallery && singleSrc && (
		<figure
			class:list={[
				"mdx-pic",
				isMirror && "mdx-pic--mirror",
				isFull && "mdx-pic--full",
			]}
		>
			<img
				class="mdx-pic__image"
				src={singleSrc}
				alt={singleCaption || ""}
				loading={loading}
				decoding="async"
				style={singleStyle}
			/>
			{singleCaption && (
				<figcaption class="mdx-pic__caption">{singleCaption}</figcaption>
			)}
		</figure>
	)
}

<style is:global>
.mdx-pic {
	margin: 1.5rem 0;
}

.mdx-pic .mdx-pic__image {
	display: block;
	width: auto;
	max-width: min(100%, 36rem);
	height: auto;
	max-height: 24rem;
	margin: 0 auto;
	border: 1px solid var(--card-border);
	border-radius: var(--radius-large);
	background: var(--card-surface);
	object-fit: contain;
	box-shadow:
		0 1px 2px color-mix(in srgb, var(--deep-text) 5%, transparent),
		0 14px 30px -24px color-mix(in srgb, var(--deep-text) 22%, transparent);
}

.mdx-pic--full .mdx-pic__image {
	max-width: 100%;
	max-height: none;
}

.mdx-pic--mirror .mdx-pic__image {
	transform: scaleX(-1);
}

.mdx-pic__caption {
	margin-top: 0.5rem;
	color: var(--content-meta);
	font-size: 0.8rem;
	line-height: 1.5;
	text-align: center;
}

/* 宫格画廊：duo 双列、feature 首图放大；图片直接落在页面上 */
.mdx-pic-gallery {
	display: grid;
	width: 100%;
	max-width: 48rem;
	gap: 0.5rem;
	margin: 1.5rem auto;
}

.mdx-pic-gallery--duo {
	max-width: 32rem;
	grid-template-columns: repeat(2, minmax(0, 1fr));
}

.mdx-pic-gallery__item {
	display: flex;
	min-width: 0;
	flex-direction: column;
	margin: 0;
}

.mdx-pic-gallery--duo .mdx-pic-gallery__item {
	aspect-ratio: 4 / 5;
}

.mdx-pic-gallery__image {
	display: block;
	width: 100%;
	min-height: 0;
	flex: 1 1 auto;
	border-radius: var(--radius-large);
	object-fit: cover;
}

.mdx-pic-gallery__caption {
	margin-top: 0.5rem;
	color: var(--content-meta);
	font-size: 0.8rem;
	line-height: 1.5;
	text-align: center;
}

.mdx-pic-gallery--feature {
	grid-template-columns: repeat(4, minmax(0, 1fr));
	grid-auto-rows: 9rem;
}

.mdx-pic-gallery--feature .mdx-pic-gallery__item:nth-child(1) {
	grid-column: span 2;
	grid-row: span 2;
}

.mdx-pic-gallery--feature .mdx-pic-gallery__item:nth-child(2) {
	grid-column: span 2;
}

.mdx-pic-gallery--feature .mdx-pic-gallery__item:nth-child(2):last-child {
	grid-row: span 2;
}

.mdx-pic-gallery--feature .mdx-pic-gallery__item:nth-child(3):last-child {
	grid-column: span 2;
}

.mdx-pic-gallery--stack {
	max-width: 48rem;
	grid-template-columns: minmax(0, 1fr);
}

.mdx-pic-gallery--stack .mdx-pic-gallery__item {
	aspect-ratio: auto;
}

.mdx-pic-gallery--stack .mdx-pic-gallery__image {
	flex: none;
	height: auto;
	object-fit: contain;
}

@media (max-width: 640px) {
	.mdx-pic-gallery--duo {
		max-width: 100%;
	}

	.mdx-pic-gallery--feature {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: 8rem;
	}
}
</style>
