---
import Icon from "@components/common/Icon.astro";

interface Props {
	title?: string;
	desc?: string;
	link: string;
	icon?: string;
	banner?: string;
}

const { title, desc, link, icon, banner } = Astro.props;

const host = (() => {
	try {
		return new URL(link).hostname;
	} catch {
		return link;
	}
})();

const displayTitle = title || host;
const isUrlIcon = icon?.startsWith("/") || icon?.startsWith("http");
---

<a
	class:list={["mdx-link-card no-styling", banner && "mdx-link-card--banner"]}
	href={link}
	target="_blank"
	rel="noopener noreferrer"
>
	{banner && (
		<img
			class="mdx-link-card__banner"
			src={banner}
			alt=""
			loading="lazy"
			decoding="async"
		/>
	)}
	<span class="mdx-link-card__main">
		<span class="mdx-link-card__icon" aria-hidden="true">
			{icon ? (
				isUrlIcon ? (
					<img src={icon} alt="" loading="lazy" decoding="async" />
				) : (
					<Icon name={icon} />
				)
			) : (
				<Icon name="material-symbols:link" />
			)}
		</span>
		<span class="mdx-link-card__content">
			<span class="mdx-link-card__title">{displayTitle}</span>
			<span class="mdx-link-card__desc">{desc || host}</span>
		</span>
		<Icon
			name="material-symbols:arrow-outward-rounded"
			class="mdx-link-card__arrow"
			aria-hidden="true"
		/>
	</span>
</a>

<style is:global>
.mdx-link-card {
	display: block;
	margin: 1rem 0;
	overflow: hidden;
	border: 1px solid var(--line-divider);
	border-radius: var(--radius-large);
	background: var(--article-surface-bg);
	color: var(--deep-text);
	text-decoration: none;
	transition:
		border-color 0.18s ease,
		transform 0.18s ease;
}

.mdx-link-card:hover,
.mdx-link-card:focus-visible {
	border-color: var(--deep-text);
	transform: translateY(-2px);
}

.mdx-link-card:focus-visible {
	outline: 2px solid var(--primary);
	outline-offset: 3px;
}

.mdx-link-card__main {
	display: grid;
	grid-template-columns: 2.25rem minmax(0, 1fr) 1.25rem;
	gap: 0.75rem;
	align-items: center;
	padding: 0.85rem 1rem;
}

.mdx-link-card__icon {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	overflow: hidden;
	border-radius: var(--radius-medium);
	background: var(--page-bg);
	color: var(--deep-text);
}

.mdx-link-card__icon svg,
.mdx-link-card__icon img {
	width: 1.25rem;
	height: 1.25rem;
	object-fit: contain;
}

.mdx-link-card__content {
	display: flex;
	min-width: 0;
	flex-direction: column;
	gap: 0.15rem;
}

.mdx-link-card__title {
	overflow: hidden;
	color: var(--deep-text);
	font-size: 0.9rem;
	font-weight: 700;
	line-height: 1.4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mdx-link-card__desc {
	overflow: hidden;
	color: var(--content-meta);
	font-size: 0.78rem;
	line-height: 1.4;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mdx-link-card__arrow {
	width: 1.25rem;
	height: 1.25rem;
	color: var(--content-meta);
	transition: color 0.18s ease;
}

.mdx-link-card:hover .mdx-link-card__arrow,
.mdx-link-card:focus-visible .mdx-link-card__arrow {
	color: var(--deep-text);
}

.mdx-link-card--banner .mdx-link-card__banner {
	display: block;
	width: 100%;
	height: 8rem;
	object-fit: cover;
}

@media (max-width: 768px) {
	.mdx-link-card--banner .mdx-link-card__banner {
		height: 6rem;
	}
}

@media (prefers-reduced-motion: reduce) {
	.mdx-link-card,
	.mdx-link-card__arrow {
		transition: none;
	}
}
</style>
