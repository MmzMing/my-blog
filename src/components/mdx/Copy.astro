---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const copyLabel = i18n(I18nKey.copyPrefix);
const copiedLabel = i18n(I18nKey.copied);
const errorLabel = i18n(I18nKey.gbCopyFailed);
---

<span class="mdx-copy-wrap">
	<button
		type="button"
		class="mdx-copy"
		data-state="idle"
		data-copy-label={copyLabel}
		data-copied-label={copiedLabel}
		data-error-label={errorLabel}
		title={copyLabel}
	>
		<span class="mdx-copy__text"><slot /></span>
		<span class="mdx-copy__icon" aria-hidden="true">
			<span class="mdx-copy__icon-layer mdx-copy__icon-layer--copy">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<rect x="8" y="8" width="14" height="14" rx="2"></rect>
					<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
				</svg>
			</span>
			<span class="mdx-copy__icon-layer mdx-copy__icon-layer--check">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path
						class="mdx-copy__check-path"
						d="M4 12l5 5L20 6"></path>
				</svg>
			</span>
			<span class="mdx-copy__icon-layer mdx-copy__icon-layer--error">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<circle cx="12" cy="12" r="10"></circle>
					<path d="M12 8v4"></path>
					<path d="M12 16h.01"></path>
				</svg>
			</span>
		</span>
	</button>
	<span class="mdx-copy__status" role="status" aria-live="polite"></span>
</span>

<script is:inline>
	(function () {
		if (window.__mdxCopyReady) return;
		window.__mdxCopyReady = true;

		document.addEventListener("click", function (event) {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const button = target.closest(".mdx-copy");
			if (!(button instanceof HTMLButtonElement)) return;

			const textElement = button.querySelector(".mdx-copy__text");
			const text = textElement ? textElement.textContent.trim() : "";
			if (!text) return;

			const status = button.parentElement?.querySelector(".mdx-copy__status");
			const copyLabel = button.dataset.copyLabel || "";
			const copiedLabel = button.dataset.copiedLabel || copyLabel;
			const errorLabel = button.dataset.errorLabel || copyLabel;

			const setState = function (state) {
				button.dataset.state = state;
				const label =
					state === "copied"
						? copiedLabel
						: state === "error"
							? errorLabel
							: copyLabel;
				if (label) {
					button.title = label;
				}
				if (status instanceof HTMLElement) {
					status.textContent =
						state === "idle"
							? ""
							: (copyLabel ? copyLabel + ": " : "") + label;
				}
			};

			window.clearTimeout(button.__mdxCopyTimer);
			setState("idle");

			const finish = function (state, delay) {
				setState(state);
				button.__mdxCopyTimer = window.setTimeout(function () {
					setState("idle");
				}, delay);
			};

			if (!navigator.clipboard?.writeText) {
				finish("error", 2200);
				return;
			}

			navigator.clipboard
				.writeText(text)
				.then(function () {
					finish("copied", 1600);
				})
				.catch(function () {
					finish("error", 2200);
				});
		});
	})();
</script>

<style is:global>
.mdx-copy-wrap {
	display: inline-flex;
	max-width: 100%;
	vertical-align: 0.05em;
}

.mdx-copy {
	display: inline-flex;
	max-width: 100%;
	align-items: center;
	gap: 0.3rem;
	padding: 0.08rem 0.4rem;
	border: 1px solid var(--line-divider);
	border-radius: var(--radius-small);
	background: var(--article-surface-bg);
	color: var(--deep-text);
	font-family: var(--font-mono, ui-monospace, monospace);
	font-size: 0.85em;
	line-height: 1.6;
	text-align: left;
	cursor: pointer;
	transition:
		background-color 0.18s ease,
		border-color 0.18s ease;
}

.mdx-copy:hover,
.mdx-copy:focus-visible {
	border-color: var(--card-border-hover);
	background: var(--btn-card-bg-hover);
}

.mdx-copy:focus-visible {
	outline: 2px solid var(--primary);
	outline-offset: 2px;
}

.mdx-copy__text {
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mdx-copy__icon {
	position: relative;
	display: inline-flex;
	width: 1em;
	height: 1em;
	flex: none;
	color: var(--content-meta);
}

.mdx-copy__icon-layer {
	position: absolute;
	inset: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	opacity: 0;
	transform: scale(0.85);
	transition:
		opacity 0.1s linear,
		transform 0.1s ease;
	will-change: opacity, transform;
}

.mdx-copy__icon-layer svg {
	width: 100%;
	height: 100%;
}

.mdx-copy__icon-layer--copy {
	opacity: 1;
	transform: none;
	transition-duration: 0.16s;
}

.mdx-copy__icon-layer--check {
	color: #16a34a;
}

.mdx-copy__icon-layer--error {
	color: #d97706;
}

:root.dark .mdx-copy__icon-layer--check {
	color: #4ade80;
}

:root.dark .mdx-copy__icon-layer--error {
	color: #fbbf24;
}

.mdx-copy[data-state="copied"] .mdx-copy__icon-layer--copy,
.mdx-copy[data-state="error"] .mdx-copy__icon-layer--copy {
	opacity: 0;
	transform: scale(0.85);
	transition-duration: 0.1s;
}

.mdx-copy[data-state="copied"] .mdx-copy__icon-layer--check,
.mdx-copy[data-state="error"] .mdx-copy__icon-layer--error {
	opacity: 1;
	transform: none;
	transition-duration: 0.16s;
}

.mdx-copy__check-path {
	stroke-dasharray: 24;
	stroke-dashoffset: 24;
}

.mdx-copy[data-state="copied"] .mdx-copy__check-path {
	stroke-dashoffset: 0;
	transition: stroke-dashoffset 0.22s ease 0.04s;
}

.mdx-copy[data-state="copied"] {
	border-color: color-mix(in srgb, #22c55e 35%, var(--line-divider));
}

.mdx-copy[data-state="error"] {
	border-color: color-mix(in srgb, #f59e0b 40%, var(--line-divider));
}

:root.dark .mdx-copy[data-state="copied"] {
	border-color: color-mix(in srgb, #4ade80 35%, var(--line-divider));
}

:root.dark .mdx-copy[data-state="error"] {
	border-color: color-mix(in srgb, #fbbf24 40%, var(--line-divider));
}

.mdx-copy__status {
	position: absolute;
	width: 1px;
	height: 1px;
	padding: 0;
	margin: -1px;
	overflow: hidden;
	clip: rect(0 0 0 0);
	white-space: nowrap;
	border: 0;
}

@media (prefers-reduced-motion: reduce) {
	.mdx-copy,
	.mdx-copy__icon-layer,
	.mdx-copy__check-path {
		transition: none !important;
	}
}
</style>
