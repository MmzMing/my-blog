---
import Icon from "@components/common/Icon.astro";
import { friendsPageConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

interface Props {
	applyLink?: string;
	commentEnabled?: boolean;
}

const { applyLink = friendsPageConfig.applyLink, commentEnabled = false } =
	Astro.props;
const site = friendsPageConfig.siteInfo;
const notes = friendsPageConfig.notes;
---

<dialog id="friend-rules-modal" class="fr-modal">
  <div class="fr-overlay" data-close-modal></div>
  <div class="fr-panel">
    <!-- 头部 -->
    <div class="fr-header">
      <h2 class="fr-title">{i18n(I18nKey.friendRulesTitle)}</h2>
      <button class="fr-close" data-close-modal aria-label={i18n(I18nKey.close)}>
        <Icon name="material-symbols:close-rounded" class="text-xl" />
      </button>
    </div>

    <!-- 内容 -->
    <div class="fr-body">
      <!-- 本站信息 -->
      {site && (
        <section class="fr-section">
          <div class="fr-section-head">
            <div class="fr-section-icon">
              <Icon name="material-symbols:info-outline-rounded" />
            </div>
            <h3>{i18n(I18nKey.friendSiteInfo)}</h3>
          </div>
          <div class="fr-info-grid">
            {[
              { label: i18n(I18nKey.siteNameLabel), value: site.name },
              { label: i18n(I18nKey.siteDescLabel), value: site.desc },
              { label: i18n(I18nKey.siteUrlLabel), value: site.url },
              { label: i18n(I18nKey.siteAvatarLabel), value: site.avatar },
            ].map((item) => (
              <div class="fr-info-row">
                <div class="fr-info-text">
                  <span class="fr-info-label">{item.label}</span>
                  <span class="fr-info-value">{item.value}</span>
                </div>
                <button
                  class="fr-copy-btn"
                  data-copy-text={item.value}
                  aria-label={`${i18n(I18nKey.copyPrefix)}${item.label}`}
                >
                  <Icon name="material-symbols:content-copy-outline-rounded" class="fr-copy-icon" />
                  <Icon name="material-symbols:check-rounded" class="fr-check-icon" />
                </button>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- 申请流程 -->
      <section class="fr-section">
        <div class="fr-section-head">
          <div class="fr-section-icon">
            <Icon name="material-symbols:list-alt-outline-rounded" />
          </div>
          <h3>{i18n(I18nKey.applyProcess)}</h3>
        </div>
        <div class="fr-steps">
          <div class="fr-step">
            <div class="fr-step-num">1</div>
            <div class="fr-step-line"></div>
            <div class="fr-step-content">
              <p class="fr-step-title">{i18n(I18nKey.applyStep1Title)}</p>
              <p class="fr-step-desc">{i18n(I18nKey.applyStep1Desc)}</p>
            </div>
          </div>
          <div class="fr-step">
            <div class="fr-step-num">2</div>
            <div class="fr-step-line"></div>
            <div class="fr-step-content">
              <p class="fr-step-title">{i18n(I18nKey.applyStep2Title)}</p>
              <p class="fr-step-desc">{i18n(I18nKey.applyStep2Desc)}</p>
              <div class="fr-template">
                <button
                  class="fr-copy-btn fr-template-copy"
                  data-copy-text={i18n(I18nKey.friendApplyTemplate)}
                  aria-label={i18n(I18nKey.copyTemplate)}
                >
                  <Icon name="material-symbols:content-copy-outline-rounded" class="fr-copy-icon" />
                  <Icon name="material-symbols:check-rounded" class="fr-check-icon" />
                </button>
                <pre class="fr-template-text">{i18n(I18nKey.friendApplyTemplate)}</pre>
              </div>
            </div>
          </div>
          <div class="fr-step">
            <div class="fr-step-num">3</div>
            <div class="fr-step-content">
              <p class="fr-step-title">{i18n(I18nKey.applyStep3Title)}</p>
              <p class="fr-step-desc">{i18n(I18nKey.applyStep3Desc)}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- 注意事项 -->
      {notes && (
        <section class="fr-section">
          <div class="fr-section-head">
            <div class="fr-section-icon">
              <Icon name="material-symbols:info-outline-rounded" />
            </div>
            <h3>{i18n(I18nKey.friendNotesTitle)}</h3>
          </div>
          <div class="fr-notes">
            {notes.map((item) => (
              <div class="fr-note">
                <span class="fr-note-dot"></span>
                <p><strong>{item.title}</strong>：{item.content}</p>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- 底部按钮 -->
    <div class="fr-footer">
      {applyLink && (
        <a
          href={applyLink}
          target="_blank"
          rel="noopener noreferrer"
          class="fr-btn fr-btn-primary"
        >
          <Icon name="material-symbols:edit-square-outline" class="text-base" />
          {i18n(I18nKey.friendSelfApply)}
        </a>
      )}
      {commentEnabled && (
        <button class="fr-btn fr-btn-secondary" data-scroll-to-friend-comments>
          <Icon name="mingcute:comment-line" class="text-base" />
          {i18n(I18nKey.goToComments)}
        </button>
      )}
    </div>
  </div>
</dialog>

<!-- 样式已迁移至 src/styles/components/friend-rules-modal.css -->

<script>
  function initFriendRulesModal() {
    const modal = document.getElementById('friend-rules-modal') as HTMLDialogElement | null;
    if (!modal) return;
    if (modal.dataset.friendRulesInitialized === 'true') return;
    modal.dataset.friendRulesInitialized = 'true';

    const openBtns = document.querySelectorAll('[data-open-friend-rules]');
    openBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        modal.showModal();
        document.body.style.overflow = 'hidden';
      });
    });

    modal.querySelectorAll('[data-close-modal]').forEach(el => {
      el.addEventListener('click', () => {
        modal.close();
        document.body.style.overflow = '';
      });
    });

    modal.querySelectorAll('[data-copy-text]').forEach(btn => {
      btn.addEventListener('click', () => {
        void navigator.clipboard.writeText(btn.getAttribute('data-copy-text') ?? '');
        btn.classList.add('copied');
        setTimeout(() => btn.classList.remove('copied'), 1500);
      });
    });

    modal.querySelectorAll('[data-scroll-to-friend-comments]').forEach(el => {
      el.addEventListener('click', () => {
        modal.close();
        document.body.style.overflow = '';
        document.getElementById('post-comments')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.close();
        document.body.style.overflow = '';
      }
    });

    modal.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
  }

  const friendRulesWindow = window as Window & {
    __friendRulesLifecycleBound?: boolean;
  };
  if (!friendRulesWindow.__friendRulesLifecycleBound) {
    const resetBodyOverflow = () => {
      document.body.style.overflow = '';
    };
    document.addEventListener('astro:before-swap', resetBodyOverflow);
    friendRulesWindow.__friendRulesLifecycleBound = true;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFriendRulesModal);
  } else {
    initFriendRulesModal();
  }
  document.addEventListener('astro:page-load', initFriendRulesModal);
  document.addEventListener('astro:after-swap', initFriendRulesModal);
</script>
