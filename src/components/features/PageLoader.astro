---
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

const pathname = Astro.url.pathname;
const isHome = pathname === "/" || pathname === "";
const { image, width, height } = siteConfig.pageLoader;
---
<div
	id="page-loader"
	class:list={["page-loader", isHome ? "page-loader--visible" : "page-loader--hidden"]}
	role="status"
	aria-live="polite"
	aria-label={i18n(I18nKey.pageLoading)}
	hidden={!isHome}
>
	<div
		aria-label={i18n(I18nKey.pageLoadingAnimation)}
		role="img"
		class="page-loader__animation"
	>
		<img
			src={image}
			alt=""
			class="page-loader__image"
			width={width}
			height={height}
			decoding="async"
		/>
	</div>
	<span class="page-loader__sr-only">{i18n(I18nKey.pageLoading)}</span>
</div>
