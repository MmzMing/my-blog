---
import Icon from "@components/common/Icon.astro";
import type { FriendLink } from "@/types/config";

interface Props {
	friend: FriendLink;
}

const { friend } = Astro.props;

const hasImage = Boolean(friend.image);

// 头像加载失败时的首字母回退
const initial = friend.title.trim().charAt(0).toUpperCase() || "?";

// 地址简化显示为域名，解析失败时回退原始链接
let hostname = friend.siteurl;
try {
	hostname = new URL(friend.siteurl).hostname;
} catch {
	// 保留原始字符串
}
---

<a
	class:list={["friend-card", hasImage && "friend-card--with-image"]}
	href={friend.siteurl}
	target="_blank"
	rel="noopener noreferrer"
	data-friend-image={hasImage ? friend.image : undefined}
>
	{hasImage && (
		<span class="friend-card__cover image-pixel-reveal-host" data-friend-cover>
			{/* 加载动效：图片加载完成后由脚本隐藏 */}
			<span class="friend-card__cover-loader" aria-hidden="true"></span>
			<span
				class="image-pixel-reveal"
				data-image-pixel-reveal
				aria-hidden="true"
			></span>
			<img
				class="friend-card__cover-img image-pixel-reveal-source"
				src={friend.image}
				alt=""
				loading="lazy"
				decoding="async"
			/>
			{/* 波浪分界线：填充色与卡片背景一致，衔接封面与信息层 */}
			<svg
				class="friend-card__wave"
				viewBox="0 0 400 24"
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<path
					d="M0,12 Q50,2 100,12 T200,12 T300,12 T400,12 V24 H0 Z"
					fill="currentColor"
				/>
			</svg>
		</span>
	)}

	<span class="friend-card__body">
		<span class="friend-card__info">
			<span class="friend-card__avatar" data-friend-avatar>
				<img
					src={friend.imgurl}
					alt=""
					loading="lazy"
					decoding="async"
				/>
				<span class="friend-card__avatar-fallback" aria-hidden="true">
					{initial}
				</span>
			</span>
			<span class="friend-card__meta">
				<span class="friend-card__name-row">
					<strong class="friend-card__name" title={friend.title}>
						{friend.title}
					</strong>
					{/* 跳转图标：悬停卡片时在名字右侧浮现 */}
					<Icon
						name="material-symbols:arrow-outward-rounded"
						class="friend-card__jump-icon"
					/>
				</span>
				<span class="friend-card__url" title={friend.siteurl}>
					{hostname}
				</span>
			</span>
		</span>

		<span class="friend-card__divider" aria-hidden="true"></span>

		<span class="friend-card__desc">{friend.desc}</span>
	</span>
</a>
