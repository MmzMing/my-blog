---
import Icon from "@components/common/Icon.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import AlbumCard from "@/components/pages/gallery/AlbumCard.astro";
import { galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAlbumCover, scanAlbumPhotos } from "@/utils/gallery-utils";
import "@/styles/pages/gallery.css";

if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.gallery);
const description = i18n(I18nKey.galleryMotto);

const albums = await Promise.all(
	galleryConfig.albums.map(async (album) => {
		const photos = await scanAlbumPhotos(album.id);
		const cover = getAlbumCover(album, photos);
		return { ...album, cover, photoCount: photos.length };
	}),
);
const galleryTabs = [
	{ id: "all", label: "全部" },
	...Array.from(
		new Set(galleryConfig.albums.flatMap((album) => album.tags ?? [])),
	).map((tag) => ({ id: tag, label: tag })),
];
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <div class="mb-8">
        <PageTitle
          title={title}
          eyebrow="Gallery"
          description={i18n(I18nKey.galleryMotto)}
          variant="stacked"
        />
      </div>

      {albums.length > 0 ? (
        <div class="gallery-tabs-wrapper">
          <div class="gallery-tabs-pill" data-gallery-tab-nav role="tablist" aria-label="相册分类">
            <div class="gallery-tabs-indicator" data-gallery-tab-indicator></div>
            {galleryTabs.map((tab, index) => (
              <button
                class:list={[
                  "gallery-tab-btn",
                  {
                    "gallery-tab-btn--active": index === 0,
                    "gallery-tab-btn--inactive": index !== 0,
                  },
                ]}
                data-gallery-tab={tab.id}
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-controls="gallery-albums"
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>

        <div id="gallery-albums" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-6" role="tabpanel">
          {albums.map((album) => (
            <AlbumCard
              id={album.id}
              name={album.name}
              cover={album.cover}
              description={album.description}
              date={album.date}
              location={album.location}
              tags={album.tags}
              photoCount={album.photoCount}
            />
          ))}
        </div>
      ) : (
        <div class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500">
          <Icon name="material-symbols:photo-library" class="text-6xl mb-4 opacity-50" />
          <p class="text-lg">{i18n(I18nKey.galleryNoAlbums)}</p>
        </div>
      )}
    </div>
  </div>

  <script is:inline>
    (function() {
      if (window.__galleryTabsReady) return;
      window.__galleryTabsReady = true;

      function updateGalleryIndicator(nav) {
        if (!nav) return;
        var indicator = nav.querySelector("[data-gallery-tab-indicator]");
        if (!indicator) return;
        var activeBtn = nav.querySelector(".gallery-tab-btn--active");
        if (!activeBtn) return;
        var navRect = nav.getBoundingClientRect();
        var btnRect = activeBtn.getBoundingClientRect();
        indicator.style.left = (btnRect.left - navRect.left) + "px";
        indicator.style.top = (btnRect.top - navRect.top) + "px";
        indicator.style.width = btnRect.width + "px";
        indicator.style.height = btnRect.height + "px";
        indicator.style.opacity = "1";
      }

      function activateGalleryTab(tabId) {
        var tabButtons = document.querySelectorAll("[data-gallery-tab]");
        var albums = document.querySelectorAll("[data-gallery-album]");

        tabButtons.forEach(function(btn) {
          var isActive = btn.dataset.galleryTab === tabId;
          btn.classList.toggle("gallery-tab-btn--active", isActive);
          btn.classList.toggle("gallery-tab-btn--inactive", !isActive);
          btn.setAttribute("aria-selected", String(isActive));
        });

        albums.forEach(function(album) {
          var tags = (album.dataset.galleryTags || "").split(",");
          var isVisible = tabId === "all" || tags.indexOf(tabId) !== -1;
          album.classList.toggle("hidden", !isVisible);
        });

        var nav = document.querySelector("[data-gallery-tab-nav]");
        if (nav) updateGalleryIndicator(nav);
      }

      document.addEventListener("click", function(event) {
        var target = event.target;
        if (!(target instanceof Element)) return;
        var btn = target.closest("[data-gallery-tab]");
        if (!btn) return;
        activateGalleryTab(btn.dataset.galleryTab);
      });

      window.addEventListener("resize", function() {
        var nav = document.querySelector("[data-gallery-tab-nav]");
        if (nav) updateGalleryIndicator(nav);
      });

      function initGalleryTabs() {
        var nav = document.querySelector("[data-gallery-tab-nav]");
        if (nav) {
          requestAnimationFrame(function() {
            updateGalleryIndicator(nav);
          });
        }
      }

      initGalleryTabs();
      document.addEventListener("astro:page-load", initGalleryTabs);
    })();
  </script>
</MainGridLayout>
