---
import CategoryFolders from "@components/widget/CategoryFolders.astro";
import TagGraph from "@components/widget/TagGraph.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import { getCategoryTagGroups, getTagGraphData } from "@/utils/content-utils";

const categoryGroups = await getCategoryTagGroups();
const tagGraph = await getTagGraphData();
const title = "标签图谱";
const description = "通过分类和标签关系图谱浏览博客中文章关系。";
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
  <div class="categories-page card-base z-10 px-4 py-6 md:px-9 relative w-full">
    <div class="categories-page__header">
      <PageTitle
        title={title}
        variant="stacked"
      />
    </div>

    <section class="categories-page__graph" aria-label="标签关系图谱">
      <TagGraph graph={tagGraph} />
    </section>

    <section class="categories-page__folders" aria-label="分类文件夹">
      <CategoryFolders groups={categoryGroups} />
    </section>
  </div>
</MainGridLayout>
