---
import CategoryExplorer from "@components/widget/CategoryExplorer.astro";
import TagGraph from "@components/widget/TagGraph.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getCategoryTagGroups, getTagGraphData } from "@/utils/content-utils";
import "@/styles/pages/categories.css";

const categoryGroups = await getCategoryTagGroups();
const tagGraph = await getTagGraphData();
const title = i18n(I18nKey.tagGraphPageTitle);
const description = i18n(I18nKey.tagGraphPageDescription);
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
  <div class="categories-page card-base z-10 px-4 py-6 md:px-9 relative w-full">
    <div class="categories-page__header">
      <PageTitle
        title={title}
        variant="stacked"
      />
    </div>

    <section class="categories-page__graph" aria-label="标签关系图谱">
      <TagGraph graph={tagGraph} />
    </section>

    <section class="categories-page__folders" aria-label={i18n(I18nKey.categoryExplorerAria)}>
      <CategoryExplorer groups={categoryGroups} />
    </section>
  </div>
</MainGridLayout>
