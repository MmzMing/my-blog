---
import Comment from "@components/comment/index.astro";
import Icon from "@components/common/Icon.astro";
import Markdown from "@components/common/Markdown.astro";
import VisitorCount from "@components/common/VisitorCount.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import QRCode from "qrcode";
import PostHeaderNav from "@/components/misc/PostHeaderNav.astro";
import "@/styles/components/post-accordion.css";
import "@/styles/components/post-hero.css";
import "@/styles/components/post-header-nav.css";
import { getCategoryHue } from "@utils/article-list-posts";
import { getSortedPosts } from "@utils/content-utils";
import {
	getCategoryArchiveUrl,
	getCategoryUrl,
	getFileDirFromPath,
	getPostUrlBySlug,
	getTagArchiveUrl,
	removeFileExtension,
} from "@utils/url-utils";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import CoverImage from "@/components/common/CoverImage.astro";
import PaperDeckleDefs from "@/components/common/PaperDeckleDefs.astro";
import PostFooterActions from "@/components/misc/PostFooterActions.astro";
import PostSectionDivider from "@/components/misc/PostSectionDivider.astro";
import RelatedPosts from "@/components/misc/RelatedPosts.astro";
import { coverImageConfig } from "@/config/coverImageConfig";
import { homeConfig } from "@/config/homeConfig";
import { siteConfig } from "@/config/siteConfig";
import { buildCoverImage, COVER_IMAGE_WIDTH } from "@/utils/cover-image";
import { formatDateI18n, formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { isPublicWikiPost, toWikiPath } from "@/utils/llm-wiki";
import { renderPostCached } from "@/utils/post-render";
import {
	getRelatedPostCards,
	type RelatedPostCard,
} from "@/utils/related-posts";
import {
	buildOrganizationEntity,
	buildPersonEntity,
	buildWebSiteEntity,
	serializeJsonLd,
} from "@/utils/schema-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	return blogEntries.map((entry) => {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const slug = removeFileExtension(entry.id);
		return {
			params: { slug },
			props: { entry },
		};
	});
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await renderPostCached(entry);
const publishedDateLabel = formatDateI18n(entry.data.published, false, true);

const bannerPostMeta = {
	title: entry.data.title,
	published: entry.data.published,
	updated: entry.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const coverApiUrls = getApiUrlList(entry.data.image, entry.id);
const { randomCoverImage } = coverImageConfig;
// 兜底图只服务于随机图：随机图关闭时没写 image 的文章直接不渲染封面区域
const coverFallbackPath = randomCoverImage.enable
	? randomCoverImage.fallback || ""
	: "";
const coverFallbackUrl = coverFallbackPath ? url(coverFallbackPath) : "";

// 详情页封面统一使用一个输出宽度
const postCover =
	(await buildCoverImage({
		image: processedImage,
		basePath: getFileDirFromPath(entry.filePath || ""),
		width: COVER_IMAGE_WIDTH,
	})) ??
	(coverFallbackPath
		? await buildCoverImage({
				image: coverFallbackPath,
				width: COVER_IMAGE_WIDTH,
			})
		: null);

const showPostCover = Boolean(coverImageConfig.enableInPost && postCover);

// 相关文章卡片：面板（ArticleTocPanel）与底部 RelatedPosts 共用同一份数据，只算一次。
// 加密文章不算——面板不启用转换（无 related 视图），底部由 RelatedPosts 回退自算。
const relatedPostCards: RelatedPostCard[] | undefined = entry.data.password
	? undefined
	: await getRelatedPostCards({
			currentId: entry.id,
			tags: entry.data.tags,
			category: entry.data.category || undefined,
			limit: 3,
		});

dayjs.extend(utc);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareTitle = entry.data.title;
const shareDescription = entry.data.description || entry.data.title;
const shareText = [shareTitle, canonicalUrl].join(" ");
const qqShareUrl = new URL("https://connect.qq.com/widget/shareqq/index.html");
qqShareUrl.searchParams.set("url", canonicalUrl);
qqShareUrl.searchParams.set("title", shareTitle);
qqShareUrl.searchParams.set("summary", shareDescription);
const emailShareUrl =
	"mailto:?subject=" +
	encodeURIComponent(shareTitle) +
	"&body=" +
	encodeURIComponent(shareText);
const feishuShareUrl =
	"https://applink.feishu.cn/client/web_url/open?url=" +
	encodeURIComponent(canonicalUrl);
const xShareUrl =
	"https://x.com/intent/post?url=" +
	encodeURIComponent(canonicalUrl) +
	"&text=" +
	encodeURIComponent(shareTitle);
const whatsAppShareUrl = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
const shareQrCode = siteConfig.postShare
	? await QRCode.toDataURL(canonicalUrl, {
			margin: 1,
			width: 192,
			errorCorrectionLevel: "M",
			color: { dark: "#000000", light: "#ffffff" },
		})
	: "";
// 加密文章与 wikiExclude 文章不生成机器可读端点，链接会指向 404
const wikiMarkdownUrl = isPublicWikiPost(entry)
	? toWikiPath(entry.id, ".md")
	: "";
const defaultStructuredImageUrl = new URL(siteConfig.defaultOgImage, Astro.site)
	.href;
const structuredImageUrl = postCover
	? new URL(postCover.src, Astro.site).href
	: defaultStructuredImageUrl;
// 本地封面在构建期能拿到确定尺寸，输出带宽高的 ImageObject；远程图只有 URL
const structuredImage =
	postCover?.width && postCover.height
		? {
				"@type": "ImageObject",
				url: structuredImageUrl,
				width: postCover.width,
				height: postCover.height,
			}
		: structuredImageUrl;

const siteRoot = new URL("/", Astro.site).href;

// 分类现有独立静态路由（/categories/<slug>/），面包屑直接指向它；
// 未分类文章不编造中间节点。
const breadcrumbItems: { name: string; url: string }[] = [
	{ name: siteConfig.title, url: siteRoot },
];
const entryCategory = entry.data.category?.trim();
if (entryCategory) {
	breadcrumbItems.push({
		name: entryCategory,
		url: new URL(getCategoryUrl(entryCategory), Astro.site).href,
	});
}
breadcrumbItems.push({ name: entry.data.title, url: canonicalUrl });

const jsonLd = {
	"@context": "https://schema.org",
	// author / publisher / isPartOf 用 @id 引用站点级实体，而 JSON-LD 的 @id 不跨文档
	// 解析，所以 Person / Organization / WebSite 必须同图输出（详见 schema-utils.ts）。
	"@graph": [
		{
			"@type": ["BlogPosting", "TechArticle"],
			// 文章实体与承载它的 WebPage 是两个节点，不能共用 canonicalUrl 当 @id
			"@id": `${canonicalUrl}#article`,
			headline: entry.data.title,
			description: entry.data.description || entry.data.title,
			keywords: entry.data.tags,
			articleSection: entry.data.category || i18n(I18nKey.uncategorized),
			wordCount: remarkPluginFrontmatter.words,
			image: structuredImage,
			author: { "@id": `${siteRoot}#person` },
			publisher: { "@id": `${siteRoot}#organization` },
			isPartOf: { "@id": `${siteRoot}#website` },
			url: canonicalUrl,
			datePublished: formatDateToYYYYMMDD(entry.data.published),
			...(entry.data.updated && {
				dateModified: formatDateToYYYYMMDD(entry.data.updated),
			}),
			mainEntityOfPage: {
				"@type": "WebPage",
				"@id": canonicalUrl,
			},
			inLanguage: entry.data.lang
				? entry.data.lang.replace("_", "-")
				: siteConfig.lang.replace("_", "-"),
		},
		buildPersonEntity(Astro.site),
		buildOrganizationEntity(Astro.site),
		buildWebSiteEntity(Astro.site),
		{
			"@type": "BreadcrumbList",
			"@id": `${canonicalUrl}#breadcrumb`,
			itemListElement: breadcrumbItems.map((item, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: item.name,
				item: item.url,
			})),
		},
	],
};

const serializedJsonLd = serializeJsonLd(jsonLd);
---

<MainGridLayout
  banner={processedImage}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCategory={entry.data.category || undefined}
  wikiMarkdownUrl={wikiMarkdownUrl}
  relatedCards={relatedPostCards}
  ogImage={structuredImageUrl}
  bannerPostMeta={bannerPostMeta}
  articleMeta={{
    published: entry.data.published,
    updated: entry.data.updated,
    author: entry.data.author || homeConfig.name,
    category: entry.data.category || undefined,
    tags: entry.data.tags,
  }}
>
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />
  
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={serializedJsonLd}
  />
  <!-- Layer 1: Title + meta -->
  <div class="post-hero rounded-(--radius-large) mb-2 onload-animation">
    <div class="post-hero__content">
      <PostHeaderNav category={entry.data.category || undefined} />

      <h1
        data-pagefind-body
        data-pagefind-weight="10"
        data-pagefind-meta="title"
        class="post-hero__title"
      >
        {entry.data.title}
      </h1>

      {/* 元信息已整体下沉到 post-accordion；这里只保留分享弹窗宿主，触发入口在右侧目录面板 */}
      {siteConfig.postShare && (
        <>
          <div
            class="post-hero__share-menu"
            role="group"
            aria-label={i18n(I18nKey.shareArticle)}
            data-share-title={shareTitle}
            data-share-text={shareDescription}
            data-share-url={canonicalUrl}
            data-pagefind-ignore
          >
            <dialog class="post-hero__share-popover" data-post-share-dialog aria-label={i18n(I18nKey.shareArticle)}>
              <header class="post-hero__share-dialog-header">
                <span><Icon name="material-symbols:share" aria-hidden="true" />{i18n(I18nKey.shareArticle)}</span>
                <button type="button" class="post-hero__share-close" data-post-share-close aria-label={i18n(I18nKey.close)}>
                  <Icon name="material-symbols:close-rounded" aria-hidden="true" />
                </button>
              </header>
              <div class="post-hero__share-qr">
                <img
                  class="post-hero__share-qr-image"
                  src={shareQrCode}
                  alt={i18n(I18nKey.scanToShare)}
                  width="96"
                  height="96"
                />
                <span class="post-hero__share-qr-label">{i18n(I18nKey.scanToShare)}</span>
              </div>

              <div class="post-hero__share-content">
                <span class="post-hero__share-title">{shareTitle}</span>
                <input class="post-hero__share-url" data-post-share-url type="text" value={canonicalUrl} readonly aria-label={i18n(I18nKey.copyLink)} />

                <div class="post-hero__share-actions">
                  <a
                    class="post-hero__share-action post-hero__share-action--qq"
                    href={qqShareUrl.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={i18n(I18nKey.shareToQQ)}
                    title={i18n(I18nKey.shareToQQ)}
                  >
                    <span class="post-hero__share-action-icon"><Icon name="fa7-brands:qq" aria-hidden="true" /></span>
                    <span class="post-hero__share-action-label">{i18n(I18nKey.shareQQ)}</span>
                  </a>
                  <a
                    class="post-hero__share-action post-hero__share-action--email"
                    href={emailShareUrl}
                    aria-label={i18n(I18nKey.shareByEmail)}
                    title={i18n(I18nKey.shareByEmail)}
                  >
                    <span class="post-hero__share-action-icon"><Icon name="material-symbols:mail-outline-rounded" aria-hidden="true" /></span>
                    <span class="post-hero__share-action-label">{i18n(I18nKey.shareEmail)}</span>
                  </a>
                  <a
                    class="post-hero__share-action post-hero__share-action--feishu"
                    href={feishuShareUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={i18n(I18nKey.shareToFeishu)}
                    title={i18n(I18nKey.shareToFeishu)}
                  >
                    <span class="post-hero__share-action-icon"><Icon name="material-symbols:send-outline-rounded" aria-hidden="true" /></span>
                    <span class="post-hero__share-action-label">{i18n(I18nKey.shareFeishu)}</span>
                  </a>
                  <a
                    class="post-hero__share-action post-hero__share-action--x"
                    href={xShareUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={i18n(I18nKey.shareToX)}
                    title={i18n(I18nKey.shareToX)}
                  >
                    <span class="post-hero__share-action-icon"><Icon name="fa7-brands:x-twitter" aria-hidden="true" /></span>
                    <span class="post-hero__share-action-label">{i18n(I18nKey.shareX)}</span>
                  </a>
                  <a
                    class="post-hero__share-action post-hero__share-action--whatsapp"
                    href={whatsAppShareUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={i18n(I18nKey.shareToWhatsApp)}
                    title={i18n(I18nKey.shareToWhatsApp)}
                  >
                    <span class="post-hero__share-action-icon"><Icon name="fa7-brands:whatsapp" aria-hidden="true" /></span>
                    <span class="post-hero__share-action-label">{i18n(I18nKey.shareWhatsApp)}</span>
                  </a>
                  <button
                    class="post-hero__share-action post-hero__share-action--copy"
                    type="button"
                    data-post-share-copy
                    data-copy-link={canonicalUrl}
                    data-copy-label={i18n(I18nKey.copyLink)}
                    data-copied-label={i18n(I18nKey.copied)}
                    data-failed-label={i18n(I18nKey.shareCopyFailed)}
                    aria-label={i18n(I18nKey.copyLink)}
                    title={i18n(I18nKey.copyLink)}
                  >
                    <span class="post-hero__share-action-icon"><Icon name="material-symbols:content-copy-outline-rounded" aria-hidden="true" /></span>
                    <span class="post-hero__share-action-label" data-post-share-copy-label>{i18n(I18nKey.copyLink)}</span>
                  </button>
                </div>
              </div>

              <span class="post-hero__share-status" role="status" aria-live="polite" data-post-share-status></span>
            </dialog>
          </div>
        </>
      )}
    </div>
  </div>

  <!-- 撕纸毛边滤镜：手风琴与许可卡共用这一份定义，整页只挂一次 -->
  <PaperDeckleDefs />

  <!-- Layer 2: 元信息手风琴 —— 提示 / 数据 / 分类 / 介绍 / 封面 -->
  {
    (() => {
      const lastModified = dayjs(entry.data.updated || entry.data.published);
      const dateStr = lastModified.format("YYYY-MM-DD");
      const outdatedThreshold = siteConfig.outdatedThreshold ?? 1;
      const categoryName = entry.data.category?.trim() || i18n(I18nKey.uncategorized);
      const tags = (entry.data.tags ?? []).filter((tag) => tag.trim());
      return (
        <div class="post-accordion mb-8" data-post-accordion>
          {siteConfig.showLastModified && (
            <section class="post-accordion__item">
              <div class="post-accordion__static">
                <div class="post-accordion__title-wrap">
                  <div
                    id="outdated-info"
                    class="post-accordion__notice"
                    data-date={lastModified.toISOString()}
                    data-threshold={outdatedThreshold}
                  >
                    <Icon name="material-symbols:schedule-outline" class="post-accordion__notice-icon" />
                    <span>
                      {i18n(I18nKey.lastModifiedPrefix)}{dateStr}
                      <span id="days-ago-text-intro" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
                      <span id="outdated-warning-intro" class="hidden">，{i18n(I18nKey.lastModifiedOutdated)}</span>
                    </span>
                  </div>
                </div>
              </div>
            </section>
          )}

          <section class="post-accordion__item" data-post-accordion-item data-open>
            <button type="button" class="post-accordion__header" aria-expanded="true" aria-controls="post-accordion-stats">
              <span class="post-accordion__title-wrap">
                <span class="post-accordion__title">{i18n(I18nKey.postStatsLabel)}</span>
              </span>
              <Icon name="material-symbols:keyboard-arrow-down-rounded" class="post-accordion__arrow" aria-hidden="true" />
            </button>
            <div class="post-accordion__panel" id="post-accordion-stats">
              <div class="post-accordion__panel-inner">
                <div class="post-accordion__content">
                  <div class="post-accordion__stats">
                    <span class="post-accordion__stat">
                      <Icon name="material-symbols:calendar-month-outline" aria-hidden="true" />
                      <span>{publishedDateLabel}</span>
                    </span>
                    <span class="post-accordion__stat-separator" aria-hidden="true">·</span>
                    <span class="post-accordion__stat">
                      <Icon name="material-symbols:article-outline" aria-hidden="true" />
                      <span>{remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount)}</span>
                    </span>
                    <span class="post-accordion__stat-separator" aria-hidden="true">·</span>
                    <span class="post-accordion__stat">
                      <Icon name="material-symbols:schedule-outline" aria-hidden="true" />
                      <span>{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount)}</span>
                    </span>
                    <span class="post-accordion__stat-separator" aria-hidden="true">·</span>
                    <span class="post-accordion__stat post-accordion__stat--views">
                      <Icon name="material-symbols:visibility-outline" aria-hidden="true" />
                      <VisitorCount id={entry.id} compact />
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="post-accordion__item" data-post-accordion-item data-open>
            <button type="button" class="post-accordion__header" aria-expanded="true" aria-controls="post-accordion-terms">
              <span class="post-accordion__title-wrap">
                <span class="post-accordion__title">{i18n(I18nKey.postCategoryLabel)}</span>
              </span>
              <Icon name="material-symbols:keyboard-arrow-down-rounded" class="post-accordion__arrow" aria-hidden="true" />
            </button>
            <div class="post-accordion__panel" id="post-accordion-terms">
              <div class="post-accordion__panel-inner">
                <div class="post-accordion__content">
                  <div class="post-accordion__terms">
                    <a
                      href={getCategoryArchiveUrl(entry.data.category || null)}
                      class="post-accordion__term-link post-accordion__term-link--category"
                      style={`--article-category-hue: ${getCategoryHue(categoryName)}`}
                    >
                      <Icon name="material-symbols:folder-outline" aria-hidden="true" />
                      <span>{categoryName}</span>
                    </a>

                    {tags.length > 0 && (
                      <>
                        <span class="post-accordion__term-separator" aria-hidden="true">/</span>
                        {tags.map((tag) => (
                          <a href={getTagArchiveUrl(tag)} class="post-accordion__term-link">
                            <Icon name="material-symbols:sell-outline" aria-hidden="true" />
                            <span>{tag.trim()}</span>
                          </a>
                        ))}
                      </>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </section>

          {entry.data.description && (
            <section class="post-accordion__item" data-post-accordion-item data-open>
              <button type="button" class="post-accordion__header" aria-expanded="true" aria-controls="post-accordion-intro">
                <span class="post-accordion__title-wrap">
                  <span class="post-accordion__title">{i18n(I18nKey.postIntroLabel)}</span>
                </span>
                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="post-accordion__arrow" aria-hidden="true" />
              </button>
              <div class="post-accordion__panel" id="post-accordion-intro">
                <div class="post-accordion__panel-inner">
                  <div class="post-accordion__content">
                    <p class="post-accordion__desc">{entry.data.description}</p>
                  </div>
                </div>
              </div>
            </section>
          )}

          {showPostCover && postCover && (
            <section class="post-accordion__item" data-post-accordion-item>
              <button type="button" class="post-accordion__header" aria-expanded="false" aria-controls="post-accordion-cover">
                <span class="post-accordion__title-wrap">
                  <span class="post-accordion__title">{i18n(I18nKey.postCoverLabel)}</span>
                </span>
                <Icon name="material-symbols:keyboard-arrow-down-rounded" class="post-accordion__arrow" aria-hidden="true" />
              </button>
              <div class="post-accordion__panel" id="post-accordion-cover">
                <div class="post-accordion__panel-inner">
                  <div class="post-accordion__content">
                    <div id="post-cover" class="post-accordion__cover" style={postCover.lqipStyle}>
                      <CoverImage
                        cover={postCover}
                        alt={`${entry.data.title} - ${i18n(I18nKey.coverImageAltSuffix)}`}
                        loading="eager"
                        fetchpriority="high"
                        apiUrls={coverApiUrls}
                        fallbackSrc={coverFallbackUrl || undefined}
                      />
                    </div>
                  </div>
                </div>
              </div>
            </section>
          )}
        </div>
      );
    })()
  }

  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-2">
    <div id="post-container" class="card-base z-10 px-3 pb-4 pt-0 relative w-full">
      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}>
          <Markdown class="mb-6! markdown-content onload-animation">
            <Content />
          </Markdown>

          <PostFooterActions
            title={entry.data.title}
            published={entry.data.published}
            id={entry.id}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
            wikiMarkdownUrl={wikiMarkdownUrl}
          />
          <PostSectionDivider />
          <RelatedPosts
            cards={relatedPostCards}
            currentId={entry.id}
            tags={entry.data.tags}
            category={entry.data.category || undefined}
          />
        </EncryptedPost>
      ) : (
        <>
          <Markdown class="mb-6! markdown-content onload-animation">
            <Content />
          </Markdown>

          <PostFooterActions
            title={entry.data.title}
            published={entry.data.published}
            id={entry.id}
            author={entry.data.author}
            sourceLink={entry.data.sourceLink}
            licenseName={entry.data.licenseName}
            licenseUrl={entry.data.licenseUrl}
            wikiMarkdownUrl={wikiMarkdownUrl}
          />
          <PostSectionDivider />
          <RelatedPosts
            cards={relatedPostCards}
            currentId={entry.id}
            tags={entry.data.tags}
            category={entry.data.category || undefined}
          />
        </>
      )}
    </div>
  </div>

  <script>
    import dayjs from "dayjs";
    import { mountPostAccordion } from "@/utils/post-accordion-controller";
    import { mountPostShare } from "@/utils/post-share-controller";
    import { definePageIsland } from "@/utils/swup-lifecycle";

    let cleanupPostShare: (() => void) | null = null;
    let cleanupPostAccordion: (() => void) | null = null;

    function initPostCoverImage() {
      const cover = document.getElementById("post-cover");
      if (!cover || cover.dataset.initialized === "true") return;
      cover.dataset.initialized = "true";

      // 候选地址与兜底图都由 CoverImage 组件写在 <img> 上
      const image = cover.querySelector<HTMLImageElement>("img[data-cover-image]");
      if (!image) return;

      let apiUrls: string[] = [];
      if (image.dataset.apiUrls) {
        try {
          apiUrls = JSON.parse(image.dataset.apiUrls);
        } catch {
          apiUrls = [];
        }
      }

      let currentApiIndex = 1;
      let triedFallback = false;
      const retryImage = () => {
        if (currentApiIndex < apiUrls.length) {
          image.addEventListener("error", retryImage, { once: true });
          image.src = apiUrls[currentApiIndex];
          currentApiIndex += 1;
          return;
        }

        const fallbackImage = image.dataset.fallbackSrc;
        if (fallbackImage && !triedFallback && image.currentSrc !== fallbackImage) {
          triedFallback = true;
          image.addEventListener("error", retryImage, { once: true });
          image.src = fallbackImage;
        }
      };

      if (image.complete) {
        if (image.naturalWidth === 0) retryImage();
      } else {
        image.addEventListener("error", retryImage, { once: true });
      }
    }

    function checkOutdated() {
      const info = document.getElementById('outdated-info');
      if (!info) return;
      const lastModified = dayjs(info.dataset.date);
      const daysDiff = dayjs().diff(lastModified, "day");
      const threshold = Number(info.dataset.threshold);

      if (daysDiff >= threshold) {
        // 提示行本身常驻，这里只标记「已过时」让图标转红，并补出天数与警告文案
        info.classList.add('is-outdated');
        if (daysDiff >= 1) {
          const textEl = document.getElementById('days-ago-text-intro');
          if (textEl && textEl.dataset.template) {
            textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
          }
          const warningEl = document.getElementById('outdated-warning-intro');
          if (warningEl) warningEl.classList.remove('hidden');
        }
      }
    }

    // checkOutdated 原先只挂在 astro:page-load 上、顶层没调，
    // 而该事件首次加载并不触发 —— 直接打开文章页时「内容可能过时」提示从来不显示。
    // 这些初始化统一走 definePageIsland，首次加载与每次导航各跑一次
    definePageIsland({
      name: "post-detail",
      mount: () => {
        initPostCoverImage();
        checkOutdated();
        cleanupPostShare = mountPostShare();
        cleanupPostAccordion = mountPostAccordion();
      },
      unmount: () => {
        cleanupPostShare?.();
        cleanupPostShare = null;
        cleanupPostAccordion?.();
        cleanupPostAccordion = null;
      },
    });
  </script>

  <div class="post-pager-row post-pager">
    <!-- 上一篇：细线下方靠左的单行文字链，无边框卡，悬停染青 -->
    <a
      class="post-pager__link post-pager__link--prev"
      href={entry.data.prevSlug ? getPostUrlBySlug(entry.data.prevSlug) : url("/")}
      title={entry.data.prevTitle || i18n(I18nKey.home)}
    >
      <Icon name="material-symbols:arrow-left-alt-rounded" class="post-pager__icon" aria-hidden="true" />
      <span class="post-pager__text">{entry.data.prevTitle || i18n(I18nKey.home)}</span>
    </a>

    <!-- 下一篇：镜像靠右 -->
    <a
      class="post-pager__link post-pager__link--next"
      href={entry.data.nextSlug ? getPostUrlBySlug(entry.data.nextSlug) : url("/")}
      title={entry.data.nextTitle || i18n(I18nKey.home)}
    >
      <span class="post-pager__text">{entry.data.nextTitle || i18n(I18nKey.home)}</span>
      <Icon name="material-symbols:arrow-right-alt-rounded" class="post-pager__icon" aria-hidden="true" />
    </a>
  </div>

  <!-- 评论 -->
  {entry.data.comment && !entry.data.password && <Comment post={entry} />}
</MainGridLayout>
