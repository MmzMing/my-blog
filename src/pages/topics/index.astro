---
import { topicDefinitions } from "@/config/topics";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
---

<MainGridLayout
	title={i18n(I18nKey.topicLibrary)}
	description={i18n(I18nKey.topicLibraryDescription)}
	hasOwnH1={true}
>
	<div class="card-base rounded-(--radius-large) p-6 md:p-9">
		<h1 class="text-3xl font-bold">{i18n(I18nKey.topicLibrary)}</h1>
		<p class="mt-3 max-w-3xl leading-7 text-(--content-meta)">
			{i18n(I18nKey.topicLibraryIntro)}
		</p>
		<div class="mt-8 grid gap-4 md:grid-cols-2">
			{topicDefinitions.map((topic) => (
				<article class="rounded-(--radius-large) border border-(--line-divider) p-5">
					<h2 class="text-xl font-semibold"><a class="hover:text-(--primary) hover:underline" href={`/topics/${topic.slug}/`}>{topic.title}</a></h2>
					<p class="mt-2 text-sm leading-6 text-(--content-meta)">{topic.description}</p>
				</article>
			))}
		</div>
	</div>
</MainGridLayout>
