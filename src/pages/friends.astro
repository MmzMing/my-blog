---
import Comment from "@components/comment/index.astro";
import Icon from "@components/common/Icon.astro";
import FriendCard from "@components/features/FriendCard.astro";
import FriendChat from "@components/features/FriendChat.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import {
	commentConfig,
	friendsPageConfig,
	getEnabledFriends,
	siteConfig,
} from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/friends.css";

// 检查页面是否启用
if (!siteConfig.pages.friends) {
	return Astro.redirect("/404/");
}

// 检查评论系统是否启用
const isCommentEnabled =
	commentConfig?.type &&
	commentConfig.type !== "none" &&
	friendsPageConfig.showComment !== false;

// 使用配置文件中的友链数据，按权重排序
const items = getEnabledFriends();

// 按 tags 分组（与原 tabs 一致的排序规则），无标签的归入未分类
const groupMap = new Map<string, typeof items>();
for (const friend of items) {
	const tags = friend.tags?.length ? friend.tags : [null];
	for (const tag of tags) {
		const key = tag ?? "__uncategorized__";
		const list = groupMap.get(key) ?? [];
		list.push(friend);
		groupMap.set(key, list);
	}
}
const groups = [...groupMap.entries()]
	.map(([key, list]) => ({
		label: key === "__uncategorized__" ? i18n(I18nKey.uncategorized) : key,
		items: list,
	}))
	.sort((a, b) => a.label.localeCompare(b.label));

const chatMessages = friendsPageConfig.chat ?? [];

// 页面标题和描述（描述仅用于 SEO meta，不再在页面内显示）
const title = friendsPageConfig.title || i18n(I18nKey.friends);
const description = friendsPageConfig.description || i18n(I18nKey.friendsMotto);
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>
  <div class="flex w-full rounded-(--radius-large) relative min-h-32">
    <div class="card-base z-10 px-4 sm:px-6 lg:px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="mb-8">
        <PageTitle
          title={title}
          eyebrow="Friends"
          description={i18n(I18nKey.friendsMotto)}
          variant="stacked"
        />
      </div>

      <!-- 折叠分类列表 -->
      {groups.length > 0 ? (
        <div class="friend-accordion-list">
          {groups.map((group) => (
            <section
              class="friend-accordion"
              data-friend-accordion
              data-open="true"
            >
              <button
                type="button"
                class="friend-accordion-header"
                aria-expanded={true}
              >
                <div class="friend-accordion-title-wrap">
                  <span class="friend-accordion-title">{group.label}</span>
                </div>
                <span class="friend-accordion-count">{group.items.length}</span>
                <Icon
                  name="material-symbols:keyboard-arrow-down-rounded"
                  class="friend-accordion-arrow"
                />
              </button>
              <div class="friend-accordion-body">
                <div class="friend-accordion-body-inner">
                  <div class="friend-card-grid">
                    {group.items.map((friend) => (
                      <FriendCard friend={friend} />
                    ))}
                  </div>
                </div>
              </div>
            </section>
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <Icon
            name="material-symbols:link-off-rounded"
            class="text-5xl text-neutral-300 dark:text-neutral-600 mb-4"
          />
          <p class="text-neutral-500 dark:text-neutral-400">
            {i18n(I18nKey.friendEmptyTitle)}
          </p>
          <p class="text-sm text-neutral-400 dark:text-neutral-500 mt-1">
            {i18n(I18nKey.friendEmptyHint)}
          </p>
        </div>
      )}

      <!-- 对话气泡 + 友链规则/本站信息 -->
      <FriendChat messages={chatMessages} />

      <!-- 手风琴展开/收起：纯 CSS 高度过渡，JS 仅切换状态 -->
      <!-- 以下两个脚本必须放在 MainGridLayout 内部（#swup-container 中），否则 swup 导航到本页时脚本不会执行 -->
      <script is:inline>
        (function () {
          if (window.__friendsAccordionReady) return;
          window.__friendsAccordionReady = true;

          document.addEventListener("click", function (e) {
            var header = e.target.closest(".friend-accordion-header");
            if (!header) return;
            var accordion = header.closest("[data-friend-accordion]");
            if (!accordion) return;
            var open = accordion.hasAttribute("data-open");
            if (open) {
              accordion.removeAttribute("data-open");
            } else {
              accordion.setAttribute("data-open", "");
            }
            header.setAttribute("aria-expanded", open ? "false" : "true");
          });
        })();
      </script>

      <!-- 头像加载失败回退首字母 + 封面图加载动效 + 悬停图片预览 -->
      <script>
      import { revealImageWithPixels } from "@/utils/image-pixel-reveal";
      import { definePageIsland } from "@/utils/swup-lifecycle";

            function initFriendAvatars(): void {
        document
          .querySelectorAll<HTMLElement>("[data-friend-avatar]")
          .forEach((box) => {
            if (box.dataset.avatarBound === "true") return;
            box.dataset.avatarBound = "true";

            const img = box.querySelector("img");
            if (!img) return;

            const markError = () => box.classList.add("is-error");
            if (img.complete && img.naturalWidth === 0) markError();
            img.addEventListener("error", markError, { once: true });
            img.addEventListener(
              "load",
              () => box.classList.remove("is-error"),
              { once: true },
            );
          });
      }

      function initFriendCovers(): void {
        document
          .querySelectorAll<HTMLElement>("[data-friend-cover]")
          .forEach((cover) => {
            if (cover.dataset.coverBound === "true") return;
            cover.dataset.coverBound = "true";

            const img = cover.querySelector("img");
            if (!img) return;

            // 已加载完成（缓存命中）：不显示 loader，图片直接淡入
            if (img.complete) {
              if (img.naturalWidth === 0) cover.classList.add("is-error");
              return;
            }

            // 加载中：显示滚动球 loader，图片隐藏
            cover.classList.add("is-loading");
            img.addEventListener(
              "load",
              () => {
                void revealImageWithPixels(cover, img);
              },
              { once: true },
            );
            img.addEventListener(
              "error",
              () => {
                cover.classList.remove("is-loading");
                cover.classList.add("is-error");
              },
              { once: true },
            );
          });
      }

      // 悬停卡片时浮出完整图片预览（限制尺寸 + 放大过渡），仅精确指针设备
      function initFriendImagePreview(): void {
        if (window.__friendImagePreviewReady) return;
        window.__friendImagePreviewReady = true;

        if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches)
          return;

        const preview = document.createElement("div");
        preview.className = "friend-image-preview";
        preview.setAttribute("aria-hidden", "true");
        const previewImg = document.createElement("img");
        previewImg.alt = "";
        preview.appendChild(previewImg);
        document.body.appendChild(preview);

        const GAP = 16;

        function place(x: number, y: number): void {
          const rect = preview.getBoundingClientRect();
          const vw = window.innerWidth;
          const vh = window.innerHeight;
          // 优先显示在鼠标右下方，空间不足时翻转到左侧/收进视口
          let left = x + GAP;
          let top = y + GAP;
          if (left + rect.width > vw - 8) left = x - rect.width - GAP;
          if (top + rect.height > vh - 8)
            top = Math.max(8, vh - rect.height - 8);
          preview.style.left = `${left}px`;
          preview.style.top = `${top}px`;
        }

        function show(card: HTMLElement, x: number, y: number): void {
          const src = card.dataset.friendImage;
          if (!src) return;
          if (previewImg.getAttribute("src") !== src) previewImg.src = src;
          preview.classList.add("is-visible");
          place(x, y);
        }

        function hide(): void {
          preview.classList.remove("is-visible");
        }

        document.addEventListener("mouseover", (e) => {
          const target = e.target as Element | null;
          const card = target?.closest?.("[data-friend-image]");
          if (card instanceof HTMLElement) {
            show(card, e.clientX, e.clientY);
          }
        });

        document.addEventListener("mouseout", (e) => {
          const target = e.target as Element | null;
          const card = target?.closest?.("[data-friend-image]");
          if (!card) return;
          const to = e.relatedTarget as Element | null;
          // 卡片内部移动不隐藏
          if (to && to.closest?.("[data-friend-image]") === card) return;
          hide();
        });

        document.addEventListener("mousemove", (e) => {
          if (!preview.classList.contains("is-visible")) return;
          place(e.clientX, e.clientY);
        });
      }

      function initFriendMedia(): void {
        initFriendAvatars();
        initFriendCovers();
        initFriendImagePreview();
      }

      // 预览元素挂在 body（Swup 容器外）跨导航留存，离开本页前清掉残留的可见态。
      // 还要摘掉 img 的 src：隐藏全靠页面级 CSS（friends.css），而它会被 swup 的
      // head 插件在导航后移除；悬停过一次的 img 若仍带 src，失去样式后会按文档流
      // 渲染成一张图出现在页脚底部。
      function hideFriendImagePreview(): void {
        const preview = document.querySelector(".friend-image-preview");
        preview?.classList.remove("is-visible");
        preview?.querySelector("img")?.removeAttribute("src");
      }

      definePageIsland({
        name: "friends:media",
        // 登记会跨导航留存在运行时登记表里，match 保证只在友链页挂载
        match: () => !!document.querySelector("[data-friend-avatar]"),
        mount: initFriendMedia,
        unmount: hideFriendImagePreview,
      });
      </script>
    </div>
  </div>

  <!-- 评论区 -->
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment customPath="/friends/" title={title} />
    </div>
  )}
</MainGridLayout>
