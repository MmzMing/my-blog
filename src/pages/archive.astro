---
import ArchivePanel from "@components/controls/ArchivePanel.astro";
import ArchiveStats from "@components/widget/ArchiveStats.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import { siteConfig } from "@/config";
import { getSortedPostsList } from "@/utils/content-utils";
import "@/styles/widgets/archive-stats.css";

const sortedPostsList = await getSortedPostsList();
const title = i18n(I18nKey.archive);
const description = i18n(I18nKey.archiveMotto);
const archiveStatsConfig = siteConfig.archiveStats;
const timezone = siteConfig.timezone ?? "UTC";
const yearMonthFormatter = new Intl.DateTimeFormat("en-US", {
	timeZone: timezone,
	year: "numeric",
	month: "numeric",
});
function getYearMonth(date: Date): { year: number; month: number } {
	const parts = yearMonthFormatter.formatToParts(date);
	return {
		year: Number(parts.find((part) => part.type === "year")?.value),
		month: Number(parts.find((part) => part.type === "month")?.value),
	};
}
const currentYearMonth = getYearMonth(new Date());
const { currentYearPosts, currentMonthPosts } = sortedPostsList.reduce(
	(counts, post) => {
		const publishedYearMonth = getYearMonth(post.data.published);
		if (publishedYearMonth.year === currentYearMonth.year) {
			counts.currentYearPosts += 1;
			if (publishedYearMonth.month === currentYearMonth.month) {
				counts.currentMonthPosts += 1;
			}
		}
		return counts;
	},
	{ currentYearPosts: 0, currentMonthPosts: 0 },
);
const archivePostSummaries = sortedPostsList.map((post) => ({
	category: post.data.category ?? null,
	tags: post.data.tags,
	published: post.data.published.getTime(),
}));
---

<MainGridLayout title={title} description={description} hasOwnH1={true} robots={Astro.url.search ? "noindex,follow" : undefined}>
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-4 py-6 md:px-9 relative w-full">
      <div class="mb-6">
        <PageTitle
          title={title}
          eyebrow="Archive"
          description={i18n(I18nKey.archiveMotto)}
          variant="stacked"
        />
      </div>
      <ArchiveStats
        totalPosts={sortedPostsList.length}
        currentYearPosts={currentYearPosts}
        currentMonthPosts={currentMonthPosts}
        currentMonthNumber={currentYearMonth.month}
        postSummaries={archivePostSummaries}
        annualPostGoal={archiveStatsConfig?.annualPostGoal ?? 0}
        totalPostsLabel={i18n(I18nKey.archiveStatsTotalPosts)}
        monthPostsLabel={i18n(I18nKey.archiveStatsMonthPosts)}
        writingSpanLabel={i18n(I18nKey.archiveStatsWritingSpan)}
        categoryPostsLabel={i18n(I18nKey.archiveStatsCategoryPosts)}
        tagPostsLabel={i18n(I18nKey.archiveStatsTagPosts)}
        progressLabel={i18n(I18nKey.archiveStatsProgress)}
        goalLabel={i18n(I18nKey.archiveStatsGoal)}
        unavailableLabel={i18n(I18nKey.archiveStatsUnavailable)}
        evaluationAheadTemplate={i18n(I18nKey.archiveStatsEvaluationAhead)}
        evaluationOnTrackTemplate={i18n(I18nKey.archiveStatsEvaluationOnTrack)}
        evaluationBehindTemplate={i18n(I18nKey.archiveStatsEvaluationBehind)}
        evaluationCompleteTemplate={i18n(I18nKey.archiveStatsEvaluationComplete)}
        client:load
      />
      <ArchivePanel sortedPosts={sortedPostsList} />
    </div>
  </div>
</MainGridLayout>
