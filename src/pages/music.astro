---
import MusicVisualizer from "@components/features/music-visualizer/MusicVisualizer.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import "@/styles/pages/music-visualizer.css";
---


<MainGridLayout title={`${i18n(I18nKey.music)} - ${i18n(I18nKey.musicVisualizer3D)}`} description={i18n(I18nKey.musicVisualizerDescription)} hasOwnH1={true}>
	<h1 class="sr-only">{`${i18n(I18nKey.music)} ${i18n(I18nKey.musicVisualizer3D)}`}</h1>
	<div class="music-visualizer-page">
		<MusicVisualizer client:only="svelte" />
	</div>
</MainGridLayout>
