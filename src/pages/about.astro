---
import { getEntry, render } from "astro:content";
import ChangelogGraph from "@components/about/ChangelogGraph.astro";
import Markdown from "@components/common/Markdown.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import SiteStructuredData from "@/components/seo/SiteStructuredData.astro";
import { siteConfig } from "@/config";
import "@/styles/components/about-chat-bubble.css";
import "@/styles/components/about-profile-card.css";
import "@/styles/components/about-social-links.css";
import "@/styles/components/about-tech-stack.css";
import "@/styles/components/about-timeline.css";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 页面开关：关闭时重定向到 404（与 friends / sponsor 等页面保持一致）
if (!siteConfig.pages.about) {
	return Astro.redirect("/404/");
}

const aboutPost = await getEntry("spec", "about");
if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
---

<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.aboutMotto)} hasOwnH1={true}>
	<SiteStructuredData slot="head" includeProfilePage={true} />
	<div class="about-page card-base z-10 px-4 py-6 md:px-9 relative w-full">
		<div class="mb-6">
			<PageTitle
				title={i18n(I18nKey.about)}
				eyebrow="About"
				description={i18n(I18nKey.aboutMotto)}
				variant="stacked"
			/>
		</div>
		<Markdown class="mb-6 markdown-content onload-animation">
			<Content />
		</Markdown>
		<section class="about-page__changelog" aria-label={i18n(I18nKey.aboutChangelogTitle)}>
			<ChangelogGraph />
		</section>
	</div>
</MainGridLayout>
