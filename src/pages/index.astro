---
import HomeBlinds from "@components/layout/HomeBlinds.astro";
import HomeDataLayer from "@components/layout/HomeDataLayer.astro";
import HomeHero from "@components/layout/HomeHero.astro";
import HomeMobile from "@components/layout/HomeMobile.astro";
import HomeSmoothScroll from "@components/layout/HomeSmoothScroll.astro";
import HomeTicker from "@components/layout/HomeTicker.astro";
import SiteStructuredData from "@/components/seo/SiteStructuredData.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/components/home-data-layer.css";
import "@/styles/components/home-hero-dialogue.css";
import "@/styles/components/home-hero.css";
import "@/styles/components/home-section.css";
import "@/styles/components/home-ticker.css";
import "@/styles/components/home-mobile.css";
import "@/styles/components/home-blinds.css";---

<MainGridLayout
	title={siteConfig.title}
	description={siteConfig.description}
	hasOwnH1={true}
>
	<SiteStructuredData slot="head" />
	<div class="home-page home-page--motion-pending">
		<HomeHero />
		<HomeTicker />
		<HomeDataLayer />
		<HomeBlinds />
		<HomeMobile />
		<HomeSmoothScroll />
	</div>
</MainGridLayout>
